+function renderCodexChatContent(content: string | ChatBlock[]): string {
+  if (typeof content === 'string') return content;
+  return content.map(block => {
+    if (block.type === 'text') return block.text;
+    if (block.type === 'tool-call') {
+      return `<tool_call name="${block.toolName}" id="${block.toolCallId}">\n${JSON.stringify(block.input)}\n</tool_call>`;
+    }
+    return `<tool_result name="${block.toolName}" id="${block.toolCallId}"${block.isError ? ' error="true"' : ''}>\n${JSON.stringify(block.output)}\n</tool_result>`;
+  }).join('\n\n');
+}
+
+function renderCodexChatPrompt(opts: ChatOpts): string {
+  const messages = opts.messages.map(m => [
+    `<message role="${m.role}">`,
+    renderCodexChatContent(m.content),
+    '</message>',
+  ].join('\n')).join('\n\n');
+
+  return [
+    'You are serving as gbrain\'s non-tool chat/synthesis model.',
+    'Follow the system and user messages exactly. Return only the final answer requested by the prompt.',
+    '',
+    opts.system ? `<system>\n${opts.system}\n</system>` : '',
+    '<messages>',
+    messages,
+    '</messages>',
+  ].filter(Boolean).join('\n');
+}
