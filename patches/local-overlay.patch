+function configuredLocalStorageRoot(): string | null {
+  const storageCfg = loadConfig()?.storage;
+  if (!storageCfg || typeof storageCfg !== 'object') return null;
+  if ((storageCfg as { backend?: unknown }).backend !== 'local') return null;
+  const localPath = (storageCfg as { localPath?: unknown }).localPath;
+  if (typeof localPath !== 'string' || !localPath) return null;
+  try {
+    return realpathSync(localPath);
+  } catch {
+    return null;
+  }
+}
+
+function existsInLocalStorage(storageRoot: string, storagePath: string): boolean {
+  const full = resolvePath(storageRoot, storagePath);
+  if (!full.startsWith(storageRoot + '/') && full !== storageRoot) return false;
+  return existsSync(full);
+}
+
+export async function checkImageAssets(engine: BrainEngine): Promise<Check | null> {
+  try {
+    const rows = await engine.executeRaw<{ source_id: string | null; storage_path: string }>(
+      `SELECT source_id, storage_path FROM files WHERE mime_type LIKE 'image/%' LIMIT 1000`
+    );
+    const sourceRows = await engine.executeRaw<{ id: string; local_path: string | null }>(
+      `SELECT id, local_path FROM sources`
+    );
+    const sourceRoots = new Map(sourceRows.map(r => [r.id, r.local_path]));
+    const storageRoot = configuredLocalStorageRoot();
+
+    let vanished = 0;
+    const vanishedPaths: string[] = [];
+    for (const r of rows) {
+      let present = false;
+
+      try {
+        statSync(r.storage_path);
+        present = true;
+      } catch {
+        const localPath = sourceRoots.get(r.source_id ?? 'default');
+        if (localPath) {
+          try {
+            statSync(join(localPath, r.storage_path));
+            present = true;
+          } catch { /* fall through to configured storage */ }
+        }
+      }
+
+      if (!present && storageRoot) {
+        present = existsInLocalStorage(storageRoot, r.storage_path);
+      }
+
+      if (!present) {
+        vanished++;
+        if (vanishedPaths.length < 5) vanishedPaths.push(r.storage_path);
+      }
+    }
+
+    if (rows.length === 0) {
+      return { name: 'image_assets', status: 'ok', message: 'No image assets indexed yet' };
+    } else if (vanished === 0) {
+      return { name: 'image_assets', status: 'ok', message: `${rows.length} image(s) all present on disk` };
+    }
+    return {
+      name: 'image_assets',
+      status: 'warn',
+      message: `${vanished} of ${rows.length} image(s) missing from disk (e.g. ${vanishedPaths.join(', ')}). ` +
+               `Fix: restore from git, or \`gbrain sync --skip-failed\` to acknowledge.`,
+    };
+  } catch {
+    // Pre-v36 brains may not have the files table on PGLite — quiet skip.
+    return null;
+  }
+}
