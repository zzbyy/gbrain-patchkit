+import type { Recipe } from '../types.ts';
+
+/**
+ * Codex through the locally authenticated `codex` CLI. This recipe is
+ * intentionally chat-only and non-tool-capable: GBrain uses it for think and
+ * synthesis verdicts, while a gateway provider such as DeepSeek owns tool
+ * loops, subagents, and Dream patterns.
+ */
+export const codex: Recipe = {
+  id: 'codex',
+  name: 'Codex (via CLI)',
+  tier: 'native',
+  implementation: 'codex-cli',
+  auth_env: { required: [] },
+  touchpoints: {
+    chat: {
+      models: ['gpt-5.5'],
+      supports_tools: false,
+      supports_subagent_loop: false,
+      supports_prompt_cache: false,
+      max_context_tokens: 200_000,
+      default_timeout_ms: 120_000,
+    },
+  },
+  aliases: { default: 'gpt-5.5' },
+  setup_hint:
+    'Install Codex CLI and log in with your ChatGPT subscription. ' +
+    'Set GBRAIN_CODEX_BIN when the `codex` command is not on PATH.',
+};
