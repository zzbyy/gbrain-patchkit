+function stringifyJobLog(message: string | TranscriptEntry): string {
+  return typeof message === 'string' ? message : JSON.stringify(message);
+}
+
+async function runInlineSubagentJob(opts: {
+  queue: MinionQueue;
+  engine: BrainEngine;
+  data: SubagentHandlerData;
+  submitOpts: Partial<MinionJobInput>;
+}): Promise<{ jobId: number; result: string }> {
+  const job = await opts.queue.add(
+    'subagent',
+    opts.data as unknown as Record<string, unknown>,
+    opts.submitOpts,
+    { allowProtectedSubmit: true },
+  );
+
+  if (job.status === 'completed' && job.result && typeof job.result === 'object') {
+    return { jobId: job.id, result: (job.result as { result?: string }).result ?? '' };
+  }
+  if (job.status !== 'waiting') {
+    throw new Error(`inline subagent job ${job.id} is ${job.status}, expected waiting`);
+  }
+
+  const lockToken = `book-mirror-inline:${randomUUID()}`;
+  const lockMs = opts.submitOpts.timeout_ms ?? 30 * 60 * 1000;
+  const claimed = await opts.queue.claim(lockToken, lockMs, job.queue, ['subagent']);
+  if (!claimed || claimed.id !== job.id) {
+    throw new Error(`inline subagent claim mismatch: expected ${job.id}, got ${claimed?.id ?? 'none'}`);
+  }
+
+  const workAbort = new AbortController();
+  const shutdownAbort = new AbortController();
+  const handler = makeSubagentHandler({ engine: opts.engine });
+  const ctx: MinionJobContext = {
+    id: claimed.id,
+    name: claimed.name,
+    data: claimed.data,
+    attempts_made: claimed.attempts_made,
+    signal: workAbort.signal,
+    shutdownSignal: shutdownAbort.signal,
+    updateProgress: async (progress) => {
+      await opts.queue.updateProgress(claimed.id, lockToken, progress);
+    },
+    updateTokens: async (tokens) => {
+      await opts.queue.updateTokens(claimed.id, lockToken, tokens);
+    },
+    log: async (message) => {
+      await opts.engine.executeRaw(
+        `UPDATE minion_jobs
+            SET stacktrace = COALESCE(stacktrace, '[]'::jsonb) || to_jsonb($1::text),
+                updated_at = now()
+          WHERE id = $2 AND status = 'active' AND lock_token = $3`,
+        [stringifyJobLog(message), claimed.id, lockToken],
+      );
+    },
+    isActive: async () => {
+      const rows = await opts.engine.executeRaw<{ id: number }>(
+        `SELECT id FROM minion_jobs WHERE id = $1 AND status = 'active' AND lock_token = $2`,
+        [claimed.id, lockToken],
+      );
+      return rows.length > 0;
+    },
+    readInbox: async () => opts.queue.readInbox(claimed.id, lockToken),
+  };
+
+  try {
+    const result = await handler(ctx);
+    await opts.queue.completeJob(claimed.id, lockToken, result as unknown as Record<string, unknown>);
+    return { jobId: claimed.id, result: result.result ?? '' };
+  } catch (e) {
+    workAbort.abort(e);
+    const msg = e instanceof Error ? e.message : String(e);
+    await opts.queue.failJob(claimed.id, lockToken, msg, 'dead');
+    throw e;
+  } finally {
+    shutdownAbort.abort();
+  }
+}
