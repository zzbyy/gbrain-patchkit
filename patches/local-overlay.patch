+// ---- Codex CLI bridge ----
+
+interface CodexCliRunResult {
+  text: string;
+  usage: ChatResult['usage'];
+  stderr?: string;
+}
+
+function envSnapshotForChild(env: Record<string, string | undefined>): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const [k, v] of Object.entries(env)) {
+    if (typeof v === 'string') out[k] = v;
+  }
+  return out;
+}
+
+function parsePositiveInt(raw: string | undefined, fallback: number): number {
+  if (!raw) return fallback;
+  const n = parseInt(raw, 10);
+  return Number.isFinite(n) && n > 0 ? n : fallback;
+}
+
+function envFlag(raw: string | undefined, fallback: boolean): boolean {
+  if (raw === undefined) return fallback;
+  const lower = raw.trim().toLowerCase();
+  if (['0', 'false', 'no', 'off'].includes(lower)) return false;
+  if (['1', 'true', 'yes', 'on'].includes(lower)) return true;
+  return fallback;
+}
+
+function normalizeCodexUsage(raw: unknown): ChatResult['usage'] {
+  const u = raw && typeof raw === 'object' ? raw as Record<string, unknown> : {};
+  return {
+    input_tokens: Number(u.input_tokens ?? u.inputTokens ?? u.prompt_tokens ?? u.promptTokens ?? 0),
+    output_tokens: Number(u.output_tokens ?? u.outputTokens ?? u.completion_tokens ?? u.completionTokens ?? 0),
+    cache_read_tokens: Number(u.cached_input_tokens ?? u.cache_read_input_tokens ?? u.cacheReadInputTokens ?? 0),
+    cache_creation_tokens: Number(u.cache_creation_input_tokens ?? u.cacheCreationInputTokens ?? 0),
+  };
+}
+
+function parseCodexJsonl(stdout: string): { lastAgentText: string; usage: ChatResult['usage'] } {
+  let lastAgentText = '';
+  let usage: ChatResult['usage'] = {
+    input_tokens: 0,
+    output_tokens: 0,
+    cache_read_tokens: 0,
+    cache_creation_tokens: 0,
+  };
+
+  for (const line of stdout.split(/\r?\n/)) {
+    const trimmed = line.trim();
+    if (!trimmed.startsWith('{')) continue;
+    let parsed: any;
+    try {
+      parsed = JSON.parse(trimmed);
+    } catch {
+      continue;
+    }
+    if (parsed?.type === 'item.completed' && parsed.item?.type === 'agent_message') {
+      if (typeof parsed.item.text === 'string') lastAgentText = parsed.item.text;
+    }
+    if (parsed?.type === 'turn.completed' && parsed.usage) {
+      usage = normalizeCodexUsage(parsed.usage);
+    }
+  }
+
+  return { lastAgentText, usage };
+}
+
+async function defaultCodexCliExecutor(
+  file: string,
+  args: string[],
+  opts: CodexCliExecutorOpts,
+): Promise<{ stdout: string; stderr: string }> {
+  const maxBuffer = 16 * 1024 * 1024;
+  return await new Promise((resolve, reject) => {
+    const child = spawn(file, args, {
+      cwd: opts.cwd,
+      env: opts.env,
+      stdio: ['pipe', 'pipe', 'pipe'],
+    });
+
+    let stdout = '';
+    let stderr = '';
+    let settled = false;
+
+    const finish = (err?: Error, result?: { stdout: string; stderr: string }) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      opts.abortSignal?.removeEventListener('abort', onAbort);
+      if (err) reject(err);
+      else resolve(result ?? { stdout, stderr });
+    };
+
+    const onAbort = () => {
+      child.kill('SIGTERM');
+      finish(new Error('Codex CLI call aborted'));
+    };
+
+    const timer = setTimeout(() => {
+      child.kill('SIGTERM');
+      finish(new Error(`Codex CLI timed out after ${opts.timeoutMs}ms`));
+    }, opts.timeoutMs);
+
+    opts.abortSignal?.addEventListener('abort', onAbort, { once: true });
+
+    child.on('error', err => {
+      const nodeErr = err as NodeJS.ErrnoException;
+      if (nodeErr.code === 'ENOENT') {
+        finish(new AIConfigError(
+          `Codex CLI executable not found: ${file}`,
+          'Install/sign in to Codex CLI, or set GBRAIN_CODEX_BIN to the codex executable path.',
+          err,
+        ));
+        return;
+      }
+      finish(err instanceof Error ? err : new Error(String(err)));
+    });
+    child.stdout?.on('data', chunk => {
+      stdout += String(chunk);
+      if (stdout.length > maxBuffer) {
+        child.kill('SIGTERM');
+        finish(new Error('Codex CLI stdout exceeded 16 MiB'));
+      }
+    });
+    child.stderr?.on('data', chunk => {
+      stderr += String(chunk);
+      if (stderr.length > maxBuffer) {
+        child.kill('SIGTERM');
+        finish(new Error('Codex CLI stderr exceeded 16 MiB'));
+      }
+    });
+    child.on('close', (code, signal) => {
+      if (code === 0) {
+        finish(undefined, { stdout, stderr });
+      } else {
+        finish(new Error(`Codex CLI exited with code ${code ?? 'null'}${signal ? ` signal ${signal}` : ''}: ${stderr.slice(0, 2000)}`));
+      }
+    });
+
+    child.stdin?.end(opts.stdin);
+  });
+}
+
+async function runCodexCliText(
+  modelId: string,
+  prompt: string,
+  opts: { abortSignal?: AbortSignal } = {},
+): Promise<CodexCliRunResult> {
+  const cfg = requireConfig();
+  if (cfg.env.GBRAIN_CODEX_BRIDGE_DEPTH) {
+    throw new AIConfigError(
+      'Codex CLI bridge refused recursive invocation.',
+      'Unset GBRAIN_CODEX_BRIDGE_DEPTH only if you are intentionally debugging nested Codex runs.',
+    );
+  }
+
+  const timeoutMs = parsePositiveInt(cfg.env.GBRAIN_CODEX_TIMEOUT_MS, 600_000);
+  const codexBin = cfg.env.GBRAIN_CODEX_BIN || 'codex';
+  const sandbox = cfg.env.GBRAIN_CODEX_SANDBOX || 'read-only';
+  const ignoreRules = envFlag(cfg.env.GBRAIN_CODEX_IGNORE_RULES, true);
+  const cwd = await mkdtemp(join(tmpdir(), 'gbrain-codex-'));
+  const outputPath = join(cwd, 'last-message.txt');
+  const args = [
+    'exec',
+    '--json',
+    '--ephemeral',
+    '--model', modelId,
+    '--sandbox', sandbox,
+    '--skip-git-repo-check',
+    '--cd', cwd,
+    '--output-last-message', outputPath,
+  ];
+  if (ignoreRules) args.push('--ignore-rules');
+  args.push('-');
+
+  try {
+    const env = {
+      ...envSnapshotForChild(cfg.env),
+      GBRAIN_CODEX_BRIDGE_DEPTH: '1',
+    };
+    const { stdout, stderr } = await _codexCliExecutor(codexBin, args, {
+      stdin: prompt,
+      env,
+      cwd,
+      timeoutMs,
+      abortSignal: opts.abortSignal,
+    });
+    const parsed = parseCodexJsonl(stdout);
+    let fileText = '';
+    try {
+      fileText = await readFile(outputPath, 'utf8');
+    } catch {
+      // Fall back to JSONL agent_message below.
+    }
+    const text = (fileText || parsed.lastAgentText).trim();
+    if (!text) {
+      throw new Error(`Codex CLI returned no assistant text${stderr ? `: ${stderr.slice(0, 1000)}` : ''}`);
+    }
+    return { text, usage: parsed.usage, stderr };
+  } finally {
+    await rm(cwd, { recursive: true, force: true });
+  }
+}
