+import { describe, expect, test, beforeEach } from 'bun:test';
+import { writeFile } from 'node:fs/promises';
+import {
+  __setCodexCliExecutorForTests,
+  chat,
+  configureGateway,
+  expand,
+  resetGateway,
+  type CodexCliExecutor,
+} from '../../src/core/ai/gateway.ts';
+import { classifyCapabilities } from '../../src/core/ai/capabilities.ts';
+import { getRecipe } from '../../src/core/ai/recipes/index.ts';
+
+describe('Codex CLI gateway provider', () => {
+  const calls: Array<{ file: string; args: string[]; stdin: string; env: Record<string, string> }> = [];
+
+  beforeEach(() => {
+    calls.length = 0;
+    resetGateway();
+    configureGateway({
+      chat_model: 'codex:gpt-5.5',
+      expansion_model: 'codex:gpt-5.5',
+      env: {
+        HOME: '/tmp/gbrain-codex-test-home',
+        PATH: '/usr/bin:/bin',
+      },
+    });
+  });
+
+  function installExecutor(answer: string, usage = { input_tokens: 12, output_tokens: 3, cached_input_tokens: 4 }) {
+    const executor: CodexCliExecutor = async (file, args, opts) => {
+      calls.push({ file, args, stdin: opts.stdin, env: opts.env });
+      const outputIdx = args.indexOf('--output-last-message');
+      expect(outputIdx).toBeGreaterThanOrEqual(0);
+      await writeFile(args[outputIdx + 1]!, answer);
+      return {
+        stdout: [
+          'WARNING: harmless non-json line',
+          JSON.stringify({ type: 'item.completed', item: { type: 'agent_message', text: 'fallback text' } }),
+          JSON.stringify({ type: 'turn.completed', usage }),
+        ].join('\n'),
+        stderr: '',
+      };
+    };
+    __setCodexCliExecutorForTests(executor);
+  }
+
+  test('registers codex:gpt-5.5 as chat-capable but not subagent/tool capable', () => {
+    const recipe = getRecipe('codex');
+    expect(recipe).toBeDefined();
+    expect(recipe!.touchpoints.chat?.models).toContain('gpt-5.5');
+    expect(recipe!.touchpoints.chat?.supports_tools).toBe(false);
+    expect(recipe!.touchpoints.chat?.supports_subagent_loop).toBe(false);
+    expect(classifyCapabilities('codex:gpt-5.5')).toBe('unusable:no_tools');
+  });
+
+  test('runs chat through codex exec without API keys', async () => {
+    installExecutor('{"answer":"ok","citations":[],"gaps":[]}');
+
+    const result = await chat({
+      model: 'codex:gpt-5.5',
+      system: 'Return JSON only.',
+      messages: [{ role: 'user', content: 'Answer with ok.' }],
+      maxTokens: 100,
+    });
+
+    expect(result.providerId).toBe('codex');
+    expect(result.model).toBe('codex:gpt-5.5');
+    expect(result.text).toBe('{"answer":"ok","citations":[],"gaps":[]}');
+    expect(result.usage).toEqual({
+      input_tokens: 12,
+      output_tokens: 3,
+      cache_read_tokens: 4,
+      cache_creation_tokens: 0,
+    });
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.file).toBe('codex');
+    expect(calls[0]!.args).toContain('exec');
+    expect(calls[0]!.args).toContain('--ephemeral');
+    expect(calls[0]!.args).toContain('--ignore-rules');
+    expect(calls[0]!.args).toContain('gpt-5.5');
+    expect(calls[0]!.args.at(-1)).toBe('-');
+    expect(calls[0]!.stdin).toContain('<system>');
+    expect(calls[0]!.stdin).toContain('Return JSON only.');
+    expect(calls[0]!.env.GBRAIN_CODEX_BRIDGE_DEPTH).toBe('1');
+  });
+
+  test('rejects tool calls before spending a codex exec turn', async () => {
+    installExecutor('should not run');
+
+    await expect(chat({
+      model: 'codex:gpt-5.5',
+      messages: [{ role: 'user', content: 'Use a tool.' }],
+      tools: [{ name: 'put_page', description: 'write', inputSchema: { type: 'object' } }],
+    })).rejects.toThrow('does not support GBrain tool calls');
+    expect(calls).toHaveLength(0);
+  });
+
+  test('refuses recursive codex bridge invocation', async () => {
+    installExecutor('should not run');
+    configureGateway({
+      chat_model: 'codex:gpt-5.5',
+      env: {
+        GBRAIN_CODEX_BRIDGE_DEPTH: '1',
+      },
+    });
+
+    await expect(chat({
+      model: 'codex:gpt-5.5',
+      messages: [{ role: 'user', content: 'hello' }],
+    })).rejects.toThrow('refused recursive invocation');
+    expect(calls).toHaveLength(0);
+  });
+
+  test('can serve expansion when explicitly configured', async () => {
+    installExecutor('{"queries":["startup investor notes","founder update history"]}');
+
+    const queries = await expand('founder traction update memo');
+
+    expect(queries).toEqual([
+      'founder traction update memo',
+      'startup investor notes',
+      'founder update history',
+    ]);
+    expect(calls[0]!.stdin).toContain('Return ONLY JSON');
+  });
+});
