#!/usr/bin/env bash
#
# gbrain-patchkit — standalone runtime/overlay patch orchestrator for gbrain
#
# Keeps local runtime overrides and git overlays alive across gbrain upgrades.
# The default path needs no provider API keys: it wires the Bun preload,
# installs the gbrain shim, and applies the current Codex CLI overlay.
#
# Layout:
#   ~/.gbrain-patchkit/bin/gbrain-patchkit     (this tool)
#   ~/.gbrain-patchkit/bin/gbrain              (non-interactive command shim)
#   ~/.gbrain-patchkit/substitutions.json      (editable patch rules)
#   ~/.gbrain-patchkit/env.sh                  (runtime pointers + optional provider env)
#   ~/.gbrain-patchkit/apply.log               (append-only audit log)
#
# Commands:
#   onboard            zero-input setup (env pointers + hook + shim + overlay)
#   onboard --interactive
#                      optional provider setup wizard (keys, URL, models)
#   install            non-interactive alias for onboard
#   configure codex-deepseek
#                      store DeepSeek key and write the native GBrain model routing profile
#   migrate            switch from source-patch to runtime SDK override (idempotent)
#   post-upgrade       refresh env pointers + reapply enabled patches after gbrain upgrade
#   upgrade            stash → git pull ~/gbrain → bun install → pop → post-upgrade
#   repair-upgrade     repair known-safe conflicts left by upgrade stash-pop
#   doctor             verify env + preload + patch state
#   overlay-snapshot   capture current ~/gbrain diff as a git patch overlay
#   overlay-apply      replay the git patch overlay after upstream upgrades
#   overlay-check      show whether the git patch overlay is applied/applicable
#   overlay-revert     reverse the git patch overlay
#   apply [--quiet]    apply every enabled substitution
#   check              show status of every substitution
#   revert             undo every substitution
#   edit               open substitutions.json in $EDITOR
#   env                open env.sh in $EDITOR
#   locate             print the resolved gbrain source directory
#   update             git pull inside the install dir
#   uninstall          remove shell hook (leaves files for you to rm)
#   help               show this help

set -euo pipefail

PATCHKIT_HOME="${GBRAIN_PATCHKIT_HOME:-$HOME/.gbrain-patchkit}"
CONFIG="$PATCHKIT_HOME/substitutions.json"
CONFIG_DEFAULT="$PATCHKIT_HOME/substitutions.default.json"
ENV_FILE="$PATCHKIT_HOME/env.sh"
LOG="$PATCHKIT_HOME/apply.log"
PATH_SHIM="$HOME/.local/bin/gbrain"
OVERLAY_PATCH="$PATCHKIT_HOME/patches/local-overlay.patch"
CALLER_GBRAIN_SOURCE_DIR="${GBRAIN_SOURCE_DIR:-}"

# Load patchkit-scoped runtime pointers for non-interactive commands. This
# keeps commands like `overlay-check` usable even when the caller's shell has
# not sourced the install hook. Values stay inside this process.
if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  . "$ENV_FILE"
fi
if [ -n "$CALLER_GBRAIN_SOURCE_DIR" ]; then
  GBRAIN_SOURCE_DIR="$CALLER_GBRAIN_SOURCE_DIR"
fi

QUIET=0
FLAGS=()
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=1 ;;
    *)       FLAGS+=("$arg") ;;
  esac
done

say()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
info() { printf '%s\n' "$*"; }
err()  { printf '%s\n' "$*" >&2; }

# A shell parameter expansion is one command word: `${EDITOR:-open -t}` tries
# to execute a binary literally named "open -t". Invoke macOS `open` and its
# `-t` argument separately, while still allowing a simple $EDITOR override.
open_in_editor() {
  local file="$1"
  if [ -n "${EDITOR:-}" ]; then
    "$EDITOR" "$file"
  elif command -v open >/dev/null 2>&1; then
    open -t "$file"
  elif command -v nano >/dev/null 2>&1; then
    nano "$file"
  else
    err "No editor found. Set EDITOR to an editor command and re-run."
    return 1
  fi
}

# --- locate gbrain source ----------------------------------------------------

resolve_gbrain_src() {
  local override="${GBRAIN_SOURCE_DIR:-}"
  if [ -n "$override" ]; then
    if [ -f "$override/package.json" ] && grep -q '"name": "gbrain"' "$override/package.json"; then
      printf '%s\n' "$override"; return
    fi
    err "GBRAIN_SOURCE_DIR set to $override but not a gbrain source tree"
    exit 1
  fi
  if ! command -v gbrain >/dev/null 2>&1; then
    err "gbrain not on PATH. Install gbrain first, or set GBRAIN_SOURCE_DIR=/path/to/gbrain."
    exit 1
  fi
  local bin real pkg_dir
  bin="$(command -v gbrain)"
  # realpath of a bare name resolves relative to cwd — this happens when gbrain
  # is a shell function. Fall back to whence -p (zsh) which gives the actual path
  # of the external command regardless of cwd.
  if [[ "$bin" != */* ]]; then
    bin="$(whence -p gbrain 2>/dev/null || command -v gbrain)"
  fi
  real="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$bin")"
  # After realpath, bin may still be the shim (e.g. /Users/zz/.gbrain-patchkit/bin/gbrain)
  # if whence-p found the shim first on PATH. Walk PATH again to find the bun shim.
  # If real resolves to the patchkit dir itself, search PATH for ~/.bun/bin/gbrain.
  if [[ "$real" == "$PATCHKIT_HOME/"* || "$real" == "$HOME/.gbrain-patchkit/"* ]]; then
    local dir candidate
    local IFS=':' arr
    read -ra arr <<< "$PATH"
    for dir in "${arr[@]}"; do
      [ -n "$dir" ] || continue
      candidate="$dir/gbrain"
      [ -f "$candidate" ] || continue
      # Skip patchkit dir entries.
      [[ "$candidate" == "$PATCHKIT_HOME/"* || "$candidate" == "$HOME/.gbrain-patchkit/"* ]] && continue
      if [ -L "$candidate" ]; then
        local target; target="$(readlink "$candidate" 2>/dev/null || true)"
        [[ "$target" == *"cli.ts"* ]] && real="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$candidate")" && break
      fi
      [ -x "$candidate" ] || continue
      real="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$candidate")"
      break
    done
  fi
  pkg_dir="$(dirname "$real")"
  while [ "$pkg_dir" != "/" ] && [ ! -f "$pkg_dir/package.json" ]; do
    pkg_dir="$(dirname "$pkg_dir")"
  done
  if [ ! -f "$pkg_dir/package.json" ] || ! grep -q '"name": "gbrain"' "$pkg_dir/package.json"; then
    err "resolved path does not look like a gbrain source tree: $pkg_dir"
    err "set GBRAIN_SOURCE_DIR=/path/to/gbrain explicitly"
    exit 1
  fi
  printf '%s\n' "$pkg_dir"
}

# --- substitution engine (python3: config parsing + file I/O) -----------------

run_engine() {
  python3 - "$@" <<'PY'
import json, pathlib, sys, datetime

mode, src_dir, config_path, log_path, quiet_flag = sys.argv[1:6]
quiet = quiet_flag == "1"

def log(msg):
    try:
        with open(log_path, "a") as f:
            ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            f.write(f"{ts} [{mode}] {msg}\n")
    except Exception:
        pass

def say(msg):
    if not quiet:
        print(msg)

def conflict_hunks(text):
    pos = 0
    while True:
        start = text.find("<<<<<<<", pos)
        if start == -1:
            return
        mid = text.find("\n=======", start)
        end_marker = text.find("\n>>>>>>>", mid + 1 if mid != -1 else start + 1)
        if mid == -1 or end_marker == -1:
            return
        end_line = text.find("\n", end_marker + 1)
        if end_line == -1:
            end_line = len(text)
        else:
            end_line += 1
        current = text[text.find("\n", start) + 1:mid]
        incoming = text[text.find("\n", mid + 1) + 1:end_marker]
        yield start, end_line, text[start:end_line], current, incoming
        pos = end_line

try:
    cfg = json.loads(pathlib.Path(config_path).read_text())
except FileNotFoundError:
    print(f"no config at {config_path}. Run: gbrain-patchkit onboard", file=sys.stderr)
    sys.exit(1)

substitutions = [s for s in cfg.get("substitutions", []) if s.get("enabled", True)]
if not substitutions:
    say("(no enabled substitutions)")
    sys.exit(0)

src = pathlib.Path(src_dir)
say(f"[patchkit] source: {src}")
if mode == "check":
    say(f"[patchkit] config: {config_path}")

exit_rc = 0
for s in substitutions:
    rel = s["file"]; name = s.get("name", rel)
    find_s = s["find"]; replace_s = s["replace"]; marker = s["marker"]
    upstream_s = s.get("upstream")
    conflict_find_s = s.get("conflict_find")
    conflict_replace_s = s.get("conflict_replace")
    p = src / rel

    if not p.exists():
        say(f"  MISSING      {rel}  ({name})")
        log(f"MISSING {rel}"); exit_rc = 2; continue

    text = p.read_text()
    has_upstream = bool(upstream_s and upstream_s in text)
    matching_conflicts = [
        h for h in conflict_hunks(text)
        if marker in h[2] or (
            (conflict_find_s and conflict_find_s in h[2])
            or (upstream_s and upstream_s in h[2])
        )
    ]
    has_conflict = bool(matching_conflicts)
    has_marker = marker in text
    has_find = find_s in text
    has_replace = replace_s in text

    if has_conflict:                     status = "conflicted"
    elif has_upstream:                   status = "upstream"
    elif has_marker and has_replace:     status = "patched"
    elif (not has_marker) and has_find:  status = "unpatched"
    else:                                status = "drifted"

    if mode == "check":
        say(f"  {status:<12} {rel}  ({name})"); continue

    if mode == "apply":
        if status in ("patched", "upstream"):
            say(f"  skip         {rel}  ({name})"); log(f"skip {rel}"); continue
        if status == "conflicted":
            if conflict_find_s and conflict_replace_s is not None:
                count = text.count(conflict_find_s)
                if count != 1:
                    say(f"  AMBIGUOUS    {rel}  ({name}) — expected 1 conflict match, found {count}")
                    log(f"AMBIGUOUS-CONFLICT {rel} matches={count}"); exit_rc = 3; continue
                new_text = text.replace(conflict_find_s, conflict_replace_s)
            elif len(matching_conflicts) == 1:
                start, end, _, current_side, _ = matching_conflicts[0]
                # The conflict was usually created by `gbrain upgrade` popping a
                # patchkit stash over newer upstream. Keep the upstream/current
                # side and let current substitutions reapply recipe-level fixes.
                if current_side and not current_side.endswith("\n"):
                    current_side += "\n"
                new_text = text[:start] + current_side + text[end:]
            else:
                say(f"  CONFLICT    {rel}  ({name}) — conflict marker found; inspect manually")
                log(f"CONFLICT {rel}"); exit_rc = 3; continue
            tmp = p.with_suffix(p.suffix + ".patchkit.tmp")
            tmp.write_text(new_text); tmp.replace(p)
            say(f"  resolved     {rel}  ({name})"); log(f"resolved {rel}"); continue
        if status == "drifted":
            say(f"  DRIFT        {rel}  ({name}) — neither form found; inspect manually")
            log(f"DRIFT {rel}"); exit_rc = 3; continue
        count = text.count(find_s)
        if count != 1:
            say(f"  AMBIGUOUS    {rel}  ({name}) — expected 1 match, found {count}")
            log(f"AMBIGUOUS {rel} matches={count}"); exit_rc = 3; continue
        tmp = p.with_suffix(p.suffix + ".patchkit.tmp")
        tmp.write_text(text.replace(find_s, replace_s)); tmp.replace(p)
        say(f"  applied      {rel}  ({name})"); log(f"applied {rel}"); continue

    if mode == "revert":
        if status == "unpatched":
            say(f"  skip         {rel}  ({name})"); log(f"skip {rel}"); continue
        if status == "upstream":
            say(f"  skip         {rel}  ({name})"); log(f"skip {rel}"); continue
        if status == "conflicted":
            say(f"  CONFLICT    {rel}  ({name}) — cannot revert cleanly")
            log(f"CONFLICT {rel}"); exit_rc = 3; continue
        if status == "drifted":
            say(f"  DRIFT        {rel}  ({name}) — cannot revert cleanly")
            log(f"DRIFT {rel}"); exit_rc = 3; continue
        tmp = p.with_suffix(p.suffix + ".patchkit.tmp")
        tmp.write_text(text.replace(replace_s, find_s)); tmp.replace(p)
        say(f"  reverted     {rel}  ({name})"); log(f"reverted {rel}"); continue

    print(f"unknown mode: {mode}", file=sys.stderr); sys.exit(2)

sys.exit(exit_rc)
PY
}

# --- helpers -----------------------------------------------------------------

ensure_config() {
  if [ ! -f "$CONFIG" ]; then
    if [ -f "$CONFIG_DEFAULT" ]; then
      cp "$CONFIG_DEFAULT" "$CONFIG"
      say "[patchkit] seeded config from $CONFIG_DEFAULT"
    else
      err "no config at $CONFIG and no default to seed from. Run: gbrain-patchkit onboard"
      exit 1
    fi
  fi
}

sync_default_substitutions() {
  [ -f "$CONFIG_DEFAULT" ] || return 0
  ensure_config
  python3 - "$CONFIG" "$CONFIG_DEFAULT" <<'PY'
import json, pathlib, sys
cfg_path, default_path = map(pathlib.Path, sys.argv[1:3])
try:
    cfg = json.loads(cfg_path.read_text())
    default = json.loads(default_path.read_text())
except Exception as e:
    print(f"[patchkit] could not sync default substitutions: {e}", file=sys.stderr)
    sys.exit(0)

subs = cfg.setdefault("substitutions", [])
seen = {
    (s.get("marker") or s.get("name") or s.get("file"))
    for s in subs
    if isinstance(s, dict)
}
added = 0
updated = 0
for s in default.get("substitutions", []):
    if not isinstance(s, dict):
        continue
    key = s.get("marker") or s.get("name") or s.get("file")
    existing = next(
        (
            item for item in subs
            if isinstance(item, dict)
            and (item.get("marker") or item.get("name") or item.get("file")) == key
        ),
        None,
    )
    if existing is not None:
        # Keep local policy fields, but refresh the patch body and drift-repair
        # metadata so installed configs can track upstream gbrain changes.
        keep = (
            {}
            if s.get("force_default_policy")
            else {k: existing[k] for k in ("enabled", "disabled_by") if k in existing}
        )
        merged = dict(s)
        merged.update(keep)
        if existing != merged:
            existing.clear()
            existing.update(merged)
            updated += 1
        continue
    subs.append(s)
    seen.add(key)
    added += 1
if added or updated:
    cfg_path.write_text(json.dumps(cfg, indent=2) + "\n")
    print(f"[patchkit] synced defaults in {cfg_path}: added {added}, updated {updated}")
PY
}

pick_rc_file() {
  if [ -f "$HOME/.zshrc" ]; then   printf '%s\n' "$HOME/.zshrc"
  elif [ -f "$HOME/.bashrc" ]; then printf '%s\n' "$HOME/.bashrc"
  else                              printf '%s\n' "$HOME/.profile"
  fi
}

install_shell_hook() {
  local rc_file; rc_file="$(pick_rc_file)"
  local start="# >>> gbrain-patchkit >>>"
  local end="# <<< gbrain-patchkit <<<"
  # Sentinel present in the current hook version but not in older hooks — lets
  # us detect stale blocks and rewrite them in place. Bump on any hook change.
  local version_sentinel='gbrain-patchkit hook v2 (scoped env)'

  # v3 sentinel — bumped when the wrapper switched from `command gbrain` to
  # `bun --preload` (BUN_PRELOAD env var is not respected by Bun 1.3.x; the
  # CLI flag is the only reliable preload mechanism).
  version_sentinel='gbrain-patchkit hook v3 (runtime override)'
  # v4 sentinel — wrapper now runs `gbrain-patchkit post-upgrade` after a
  # successful `gbrain upgrade`, so source-patch extensions reapply cleanly.
  version_sentinel='gbrain-patchkit hook v4 (upgrade post-hook)'

  local has_block=0 is_current=0
  if grep -qF "$start" "$rc_file" 2>/dev/null; then
    has_block=1
    if awk -v s="$start" -v e="$end" -v v="$version_sentinel" '
      $0 ~ s {inside=1; next}
      $0 ~ e {inside=0; next}
      inside && index($0, v) {found=1}
      END {exit found ? 0 : 1}
    ' "$rc_file" 2>/dev/null; then
      is_current=1
    fi
  fi

  if [ "$has_block" = "1" ] && [ "$is_current" = "1" ]; then
    say "[install] shell hook already present and current in $rc_file"
    return
  fi

  if [ "$has_block" = "1" ] && [ "$is_current" = "0" ]; then
    # Old hook — strip it before writing the new one so we don't duplicate.
    local tmp; tmp="$(mktemp)"
    python3 - "$rc_file" "$tmp" "$start" "$end" <<'PY'
import pathlib, sys
src, dst, start, end = sys.argv[1:5]
text = pathlib.Path(src).read_text()
i = text.find(start); j = text.find(end, i+1)
if i == -1 or j == -1:
    pathlib.Path(dst).write_text(text); sys.exit(0)
out = text[:i].rstrip("\n") + "\n" + text[j+len(end):].lstrip("\n")
pathlib.Path(dst).write_text(out)
PY
    mv "$tmp" "$rc_file"
    say "[install] removed stale hook block from $rc_file"
  fi

  cat >> "$rc_file" <<EOF

$start
# gbrain-patchkit hook v4 (upgrade post-hook) — do not edit this line; it marks the hook version.
# Added by gbrain-patchkit. Remove this block between the markers to uninstall.
# Keys + GBRAIN_ENTRY/GBRAIN_OVERRIDE_JS live in ~/.gbrain-patchkit/env.sh and
# are sourced ONLY inside the gbrain function below — they never leak into the
# parent shell or sibling tools (Claude Code, codex, etc.).
#
# The wrapper invokes \`bun --preload <override.js> <cli.ts>\` directly. Bun's
# BUN_PRELOAD env var is not respected (1.3.x); the --preload flag is the only
# reliable hook point. Falling back to \`command gbrain\` if env vars are missing
# (which means the SDK runs unwrapped — fix with: gbrain-patchkit migrate).
export PATH="\$HOME/.gbrain-patchkit/bin:\$PATH"
gbrain() {
  local rc
  (
    [ -f "\$HOME/.gbrain-patchkit/env.sh" ] && . "\$HOME/.gbrain-patchkit/env.sh"
    if [ -n "\${GBRAIN_ENTRY:-}" ] && [ -f "\$GBRAIN_ENTRY" ] \\
       && [ -n "\${GBRAIN_OVERRIDE_JS:-}" ] && [ -f "\$GBRAIN_OVERRIDE_JS" ] \\
       && command -v bun >/dev/null 2>&1; then
      if [ "\${1:-}" = "upgrade" ]; then
        bun --preload "\$GBRAIN_OVERRIDE_JS" "\$GBRAIN_ENTRY" "\$@"
        rc=\$?
        if [ "\$rc" -eq 0 ] && command -v gbrain-patchkit >/dev/null 2>&1; then
          gbrain-patchkit post-upgrade --quiet || true
        fi
        exit "\$rc"
      fi
      exec bun --preload "\$GBRAIN_OVERRIDE_JS" "\$GBRAIN_ENTRY" "\$@"
    fi
    # Fallback: native gbrain bin without preload. Override won't engage; run
    # \`gbrain-patchkit migrate\` to set GBRAIN_ENTRY/GBRAIN_OVERRIDE_JS.
    if [ "\${1:-}" = "upgrade" ]; then
      command gbrain "\$@"
      rc=\$?
      if [ "\$rc" -eq 0 ] && command -v gbrain-patchkit >/dev/null 2>&1; then
        gbrain-patchkit post-upgrade --quiet || true
      fi
      exit "\$rc"
    fi
    exec command gbrain "\$@"
  )
  rc=\$?
  return \$rc
}
$end
EOF
  if [ "$has_block" = "1" ]; then
    say "[install] upgraded hook in $rc_file — run: source $rc_file"
  else
    say "[install] added hook to $rc_file — run: source $rc_file"
  fi
}

install_path_shim() {
  local shim_src="$PATCHKIT_HOME/bin/gbrain"
  local shim_dst="$PATH_SHIM"
  local shim_dir
  shim_dir="$(dirname "$shim_dst")"

  if [ ! -f "$shim_src" ]; then
    say "[install] command shim missing at $shim_src — non-interactive gbrain calls may bypass patchkit"
    return
  fi

  mkdir -p "$shim_dir"

  if [ -L "$shim_dst" ]; then
    local target
    target="$(readlink "$shim_dst" || true)"
    if [ "$target" = "$shim_src" ]; then
      say "[install] command shim already present at $shim_dst"
      return
    fi
    say "[install] $shim_dst already points to $target; leaving it unchanged"
    say "[install] non-interactive callers should put $PATCHKIT_HOME/bin before the native gbrain bin"
    return
  fi

  if [ -e "$shim_dst" ]; then
    if grep -q 'gbrain-patchkit command shim' "$shim_dst" 2>/dev/null; then
      cp "$shim_src" "$shim_dst"
      chmod +x "$shim_dst"
      say "[install] refreshed command shim at $shim_dst"
      return
    fi
    say "[install] $shim_dst already exists and is not a patchkit shim; leaving it unchanged"
    say "[install] non-interactive callers should put $PATCHKIT_HOME/bin before the native gbrain bin"
    return
  fi

  ln -s "$shim_src" "$shim_dst"
  say "[install] linked command shim at $shim_dst"
}

remove_shell_hook() {
  local rc_file; rc_file="$(pick_rc_file)"
  if ! grep -qF "# >>> gbrain-patchkit >>>" "$rc_file" 2>/dev/null; then
    say "[uninstall] no hook found in $rc_file"
    return
  fi
  local tmp; tmp="$(mktemp)"
  python3 - "$rc_file" "$tmp" <<'PY'
import pathlib, sys
src, dst = sys.argv[1], sys.argv[2]
text = pathlib.Path(src).read_text()
start, end = "# >>> gbrain-patchkit >>>", "# <<< gbrain-patchkit <<<"
i = text.find(start)
j = text.find(end, i+1)
if i == -1 or j == -1:
    pathlib.Path(dst).write_text(text); sys.exit(0)
# Also strip the blank line before the block if present
out = text[:i].rstrip("\n") + "\n" + text[j+len(end):].lstrip("\n")
pathlib.Path(dst).write_text(out)
PY
  mv "$tmp" "$rc_file"
  say "[uninstall] removed hook block from $rc_file"
}

mask() {
  # Mask a secret: show last 4 chars preceded by ****.
  local v="$1"
  local n=${#v}
  if [ "$n" -le 8 ]; then printf '(%d chars)\n' "$n"; return; fi
  printf '****%s\n' "${v: -4}"
}

prompt() {
  # prompt "Question" "default" varname
  local q="$1" def="$2" var="$3" ans
  if [ -n "$def" ]; then
    read -r -p "  $q [$def]: " ans || true
    printf -v "$var" '%s' "${ans:-$def}"
  else
    read -r -p "  $q: " ans || true
    printf -v "$var" '%s' "$ans"
  fi
}

prompt_secret() {
  # prompt_secret "Question" varname
  local q="$1" var="$2" ans
  read -r -s -p "  $q: " ans || true
  echo
  printf -v "$var" '%s' "$ans"
}

PRELOAD_FILE="$PATCHKIT_HOME/anthropic-override.js"

# Resolve gbrain's actual entry script (real path, following symlinks).
# bun-link installs ~/.bun/bin/gbrain as a symlink chain that ends at the
# user's gbrain checkout's src/cli.ts. The runtime-override wrapper invokes
# bun --preload directly against this entry, bypassing the bun-link bin.
resolve_gbrain_entry() {
  if ! command -v gbrain >/dev/null 2>&1; then return 1; fi
  local bin real
  bin="$(command -v gbrain)"
  real="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$bin" 2>/dev/null || true)"
  [ -n "$real" ] && [ -f "$real" ] || return 1
  printf '%s\n' "$real"
}

# Build the runtime-override export block for env.sh. Three vars:
#   GBRAIN_SOURCE_DIR — anchor for the preload's createRequire (the preload
#                       lives in ~/.gbrain-patchkit/ which has no node_modules)
#   GBRAIN_ENTRY      — absolute path to gbrain's cli.ts; the shell-function
#                       wrapper invokes `bun --preload <override> $GBRAIN_ENTRY`
#                       so Bun honors the preload (its BUN_PRELOAD env var is
#                       not respected; --preload flag is the only path that
#                       works on every invocation in Bun 1.3.x)
#   GBRAIN_OVERRIDE_JS — absolute path to the preload module (used by the
#                       wrapper's --preload argument).
emit_preload_block() {
  local src="$1"     # absolute path to gbrain source dir, may be empty
  local entry="$2"   # absolute path to gbrain's cli.ts entry, may be empty
  printf '\n# Anthropic SDK runtime override (replaces source-patch mechanism).\n'
  printf '# Loaded via `bun --preload` in the gbrain shell-function wrapper;\n'
  printf '# intercepts Messages.create to swap models. ~/gbrain stays untouched.\n'
  if [ -n "$src" ]; then
    printf 'export GBRAIN_SOURCE_DIR=%q\n' "$src"
  else
    printf '# export GBRAIN_SOURCE_DIR=/path/to/gbrain   # (auto-detect failed; set manually)\n'
  fi
  if [ -n "$entry" ]; then
    printf 'export GBRAIN_ENTRY=%q\n' "$entry"
  else
    printf '# export GBRAIN_ENTRY=/path/to/gbrain/src/cli.ts   # (auto-detect failed; set manually)\n'
  fi
  printf 'export GBRAIN_OVERRIDE_JS=%q\n' "$PRELOAD_FILE"
}

write_env_file() {
  # Args passed as VAR=VAL pairs, one per line in the env file.
  local openai="$1" minimax="$2" minimax_base="$3" exp_model="$4" sub_model="$5"
  local src="" entry=""
  src="$(resolve_gbrain_src 2>/dev/null || true)"
  if [ -n "$src" ] && [ -f "$src/src/cli.ts" ]; then
    entry="$src/src/cli.ts"
  else
    entry="$(resolve_gbrain_entry 2>/dev/null || true)"
  fi
  umask 077
  cat > "$ENV_FILE" <<EOF
# ~/.gbrain-patchkit/env.sh — generated by gbrain-patchkit onboard
# Sourced from your shell rc via the patchkit install block.
# Safe to hand-edit. Re-run \`gbrain-patchkit onboard --reconfigure\` to rewrite.

EOF
  [ -n "$openai" ]       && printf 'export OPENAI_API_KEY=%q\n'           "$openai"       >> "$ENV_FILE"
  [ -n "$minimax" ]      && printf 'export ANTHROPIC_API_KEY=%q\n'        "$minimax"      >> "$ENV_FILE"
  [ -n "$minimax_base" ] && printf 'export ANTHROPIC_BASE_URL=%q\n'       "$minimax_base" >> "$ENV_FILE"
  [ -n "$exp_model" ]    && printf 'export GBRAIN_EXPANSION_MODEL=%q\n'   "$exp_model"    >> "$ENV_FILE"
  [ -n "$sub_model" ]    && printf 'export GBRAIN_SUBAGENT_MODEL=%q\n'    "$sub_model"    >> "$ENV_FILE"
  [ -n "$sub_model" ]    && printf 'export GBRAIN_THINK_MODEL=%q\n'       "$sub_model"    >> "$ENV_FILE"
  [ -n "$sub_model" ]    && printf 'export GBRAIN_ANTHROPIC_MODEL_MAP=%q\n' "{\"haiku\":\"$sub_model\",\"sonnet\":\"$sub_model\",\"opus\":\"$sub_model\"}" >> "$ENV_FILE"
  emit_preload_block "$src" "$entry" >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

write_minimal_env_file() {
  local src="$1" entry=""
  if [ -n "$src" ] && [ -f "$src/src/cli.ts" ]; then
    entry="$src/src/cli.ts"
  else
    entry="$(resolve_gbrain_entry 2>/dev/null || true)"
  fi
  umask 077
  cat > "$ENV_FILE" <<EOF
# ~/.gbrain-patchkit/env.sh — generated by gbrain-patchkit onboard
# Runtime-only setup. No provider API keys are required for the Codex CLI overlay.
# Safe to hand-edit if you later want to add optional provider keys/models.

EOF
  emit_preload_block "$src" "$entry" >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

# Append GBRAIN_SOURCE_DIR + GBRAIN_ENTRY + GBRAIN_OVERRIDE_JS exports to an
# existing env.sh if they aren't there yet. Used by `migrate` so existing
# installs gain the runtime override without losing their hand-edited keys.
ensure_preload_export() {
  local src="$1"
  local entry=""
  entry="$(resolve_gbrain_entry 2>/dev/null || true)"

  if [ ! -f "$ENV_FILE" ]; then
    umask 077
    cat > "$ENV_FILE" <<EOF
# ~/.gbrain-patchkit/env.sh — created by gbrain-patchkit migrate
# Sourced from your shell rc via the patchkit install block.

EOF
    chmod 600 "$ENV_FILE"
  fi

  local has_source_dir=0 has_entry=0 has_override=0
  grep -qE '^[[:space:]]*export[[:space:]]+GBRAIN_SOURCE_DIR='  "$ENV_FILE" 2>/dev/null && has_source_dir=1
  grep -qE '^[[:space:]]*export[[:space:]]+GBRAIN_ENTRY='       "$ENV_FILE" 2>/dev/null && has_entry=1
  grep -qE '^[[:space:]]*export[[:space:]]+GBRAIN_OVERRIDE_JS=' "$ENV_FILE" 2>/dev/null && has_override=1

  if [ "$has_source_dir" = "1" ] && [ "$has_entry" = "1" ] && [ "$has_override" = "1" ]; then
    say "[migrate] runtime-override exports already configured in $ENV_FILE"
    return
  fi

  {
    printf '\n# --- runtime override (added by gbrain-patchkit migrate) ---\n'
    [ "$has_source_dir" = "0" ] && [ -n "$src" ]   && printf 'export GBRAIN_SOURCE_DIR=%q\n' "$src"
    [ "$has_entry"      = "0" ] && [ -n "$entry" ] && printf 'export GBRAIN_ENTRY=%q\n'      "$entry"
    [ "$has_override"   = "0" ]                    && printf 'export GBRAIN_OVERRIDE_JS=%q\n' "$PRELOAD_FILE"
    # Cleanup: older patchkit versions wrote a no-op BUN_PRELOAD line. Leave any
    # existing one alone — it's harmless — but don't re-add it.
  } >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  say "[migrate] appended runtime-override exports to $ENV_FILE"
}

refresh_preload_exports() {
  local src="$1"
  local entry=""
  if [ -n "$src" ] && [ -f "$src/src/cli.ts" ]; then
    entry="$src/src/cli.ts"
  else
    entry="$(resolve_gbrain_entry 2>/dev/null || true)"
  fi

  if [ ! -f "$ENV_FILE" ]; then
    ensure_preload_export "$src"
    return
  fi

  python3 - "$ENV_FILE" "$src" "$entry" "$PRELOAD_FILE" <<'PY'
import pathlib, shlex, sys
path, src, entry, override = sys.argv[1:5]
p = pathlib.Path(path)
lines = p.read_text().splitlines()
updates = {
    "GBRAIN_SOURCE_DIR": src,
    "GBRAIN_ENTRY": entry,
    "GBRAIN_OVERRIDE_JS": override,
}
seen = set()
out = []
for line in lines:
    stripped = line.strip()
    replaced = False
    for key, value in updates.items():
        if stripped.startswith(f"export {key}="):
            out.append(f"export {key}={shlex.quote(value)}" if value else line)
            seen.add(key)
            replaced = True
            break
    if not replaced:
        out.append(line)
missing = [k for k in updates if k not in seen and updates[k]]
if missing:
    out.append("")
    out.append("# --- runtime override (refreshed by gbrain-patchkit post-upgrade) ---")
    for key in missing:
        out.append(f"export {key}={shlex.quote(updates[key])}")
p.write_text("\n".join(out).rstrip() + "\n")
PY
  chmod 600 "$ENV_FILE"
}

# End-to-end smoke test: invoke `bun --preload <override>` against a
# tiny script that requires the gbrain SDK and inspects whether
# Messages.prototype.create has been wrapped by our preload. This catches
# both SDK-shape drift AND any future change in how Bun loads --preload.
# Returns 0 on success.
smoke_test_preload() {
  local src="$1"
  [ -z "$src" ] && return 0
  if ! command -v bun >/dev/null 2>&1; then
    say "[migrate] bun not on PATH; skipping smoke test"
    return 0
  fi
  if [ ! -f "$PRELOAD_FILE" ]; then
    err "[migrate] preload file missing: $PRELOAD_FILE"
    return 1
  fi
  local out
  out="$(GBRAIN_SOURCE_DIR="$src" \
         GBRAIN_EXPANSION_MODEL=__patchkit_smoke__ \
         bun --preload "$PRELOAD_FILE" -e '
    const path = require("path");
    const Module = require("module");
    const r = Module.createRequire(path.join(process.env.GBRAIN_SOURCE_DIR, "package.json"));
    const M = r("@anthropic-ai/sdk/resources/messages.js").Messages;
    // Replace inner orig with a body-recording stub so we can observe what swap() returned.
    // The wrapper installed by the preload calls orig.call(this, swap(body)).
    // We probe by reading the wrapped function source: a wrapped function contains "swap".
    const wrapped = M.prototype.create.toString().includes("swap(body)");
    console.log(wrapped ? "wrapped" : "unwrapped");
  ' 2>&1)"
  case "$out" in
    wrapped)
      say "[migrate] ✓ runtime override engages under \`bun --preload\`"
      return 0 ;;
    unwrapped)
      err "[migrate] ✗ preload ran but did NOT wrap Messages.create"
      err "          The SDK shape may have drifted. Inspect: $PRELOAD_FILE"
      return 1 ;;
    *)
      err "[migrate] ✗ smoke test returned unexpected output:"
      err "$out"
      return 1 ;;
  esac
}

# Detect the bun-link cli.ts mode-flip and offer to fix it once via
# git update-index. Strictly opt-in (default Y but plainly explained).
# This is the one place patchkit will touch ~/gbrain — only with consent.
offer_clits_fix() {
  local src="$1"
  [ -z "$src" ] && return 0
  [ ! -f "$src/src/cli.ts" ] && return 0
  if ! command -v git >/dev/null 2>&1 || [ ! -d "$src/.git" ]; then return 0; fi

  local porcelain
  porcelain="$(git -C "$src" status --porcelain src/cli.ts 2>/dev/null || true)"
  [ -z "$porcelain" ] && return 0

  # Only offer if the diff is mode-only (no content change). `git diff
  # --summary` prints a "mode change" line for mode-only edits.
  local summary
  summary="$(git -C "$src" diff --summary -- src/cli.ts 2>/dev/null || true)"
  case "$summary" in
    *"mode change"*) ;;
    *) return 0 ;;
  esac

  info ""
  info "[migrate] ~/gbrain/src/cli.ts has a mode-only diff (100644 → 100755)."
  info "          This is Bun re-chmod'ing shebang files on every \`bun link\` —"
  info "          not patchkit. It's the remaining reason \`git pull\` aborts."
  info ""
  info "          One-time fix: mark cli.ts executable in the gbrain index"
  info "          (\`git -C $src update-index --chmod=+x src/cli.ts\`)."
  info "          This DOES touch ~/gbrain. Decline if you want to keep the"
  info "          tree pristine and stash/reset cli.ts manually before pulls."
  info ""
  local ans=""
  prompt "Apply the cli.ts mode fix now? [y/N]" "N" ans
  case "$ans" in
    y|Y|yes|Yes|YES)
      if git -C "$src" update-index --chmod=+x src/cli.ts 2>/dev/null; then
        info "[migrate] ✓ marked src/cli.ts executable in the gbrain index"
        info "[migrate]   git -C $src status now shows it staged; commit it from"
        info "[migrate]   your gbrain checkout, or revert with: git -C $src restore --staged src/cli.ts"
      else
        err  "[migrate] ✗ git update-index failed; skipping"
      fi
      ;;
    *)
      info "[migrate] skipped cli.ts fix (you can re-run \`gbrain-patchkit migrate\` any time)"
      ;;
  esac
}

detect_existing_auth() {
  # Populates globals:
  #   DET_OPENAI_SET (0|1) + DET_OPENAI_MASKED
  #   DET_ANTHROPIC_SET (0|1) + DET_ANTHROPIC_MASKED + DET_ANTHROPIC_BASE
  #   DET_OPENCLAW_PRESENT (0|1) + DET_OPENCLAW_GATEWAY_PORT
  #   DET_OPENCLAW_GATEWAY_TOKEN_SET (0|1)
  #   DET_OPENCLAW_MINIMAX_MODE (oauth|apikey|"")
  #   OC_MODELS[]       — TAB-separated rows: key<TAB>usable(yes|no|cli)<TAB>provider<TAB>baseUrl
  DET_OPENAI_SET=0; DET_OPENAI_MASKED=""
  DET_ANTHROPIC_SET=0; DET_ANTHROPIC_MASKED=""; DET_ANTHROPIC_BASE=""
  DET_OPENCLAW_PRESENT=0; DET_OPENCLAW_GATEWAY_PORT=""
  DET_OPENCLAW_GATEWAY_TOKEN_SET=0; DET_OPENCLAW_MINIMAX_MODE=""
  OC_MODELS=()

  if [ -n "${OPENAI_API_KEY:-}" ]; then
    DET_OPENAI_SET=1; DET_OPENAI_MASKED="$(mask "$OPENAI_API_KEY")"
  fi
  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    DET_ANTHROPIC_SET=1; DET_ANTHROPIC_MASKED="$(mask "$ANTHROPIC_API_KEY")"
    DET_ANTHROPIC_BASE="${ANTHROPIC_BASE_URL:-}"
  fi
  if [ -n "${OPENCLAW_GATEWAY_TOKEN:-}" ]; then
    DET_OPENCLAW_GATEWAY_TOKEN_SET=1
  fi

  local cfg="$HOME/.openclaw/openclaw.json"
  if [ -f "$cfg" ]; then
    DET_OPENCLAW_PRESENT=1
    DET_OPENCLAW_GATEWAY_PORT="$(python3 -c "
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print(d.get('gateway',{}).get('port','') or '')
except Exception:
    pass
" "$cfg" 2>/dev/null || true)"
    DET_OPENCLAW_MINIMAX_MODE="$(python3 -c "
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    p=d.get('auth',{}).get('profiles',{}).get('minimax-portal:default',{})
    print(p.get('mode','') or '')
except Exception:
    pass
" "$cfg" 2>/dev/null || true)"
    # Extract model registry + classify by gbrain usability
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      OC_MODELS+=("$line")
    done < <(python3 - "$cfg" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
models = d.get('agents', {}).get('defaults', {}).get('models', {})
providers = d.get('models', {}).get('providers', {})
for key in sorted(models.keys()):
    prov = key.split('/', 1)[0] if '/' in key else key
    pcfg = providers.get(prov, {})
    api = pcfg.get('api', '') or ''
    base = pcfg.get('baseUrl', '') or ''
    if api == 'anthropic-messages' or prov == 'anthropic':
        usable = 'yes'
    elif prov == 'claude-cli':
        usable = 'cli'
    else:
        usable = 'no'
    # TAB-separated: key\tusable\tprovider\tbaseUrl
    print(f"{key}\t{usable}\t{prov}\t{base}")
PY
)
  fi
}

# Pick a model from OC_MODELS (or fall back to a plain prompt).
# Args:
#   $1 = prompt label (e.g. "Query-expansion model")
#   $2 = variable name to set with the chosen model
#   $3 = "keep-prefix" or "strip-prefix" (controls whether we emit
#        "minimax-portal/MiniMax-M2.7" vs just "MiniMax-M2.7")
#   $4 = fallback default if no models detected
pick_model() {
  local label="$1" var="$2" prefix_mode="$3" fallback="$4"
  local picked=""
  if [ "${#OC_MODELS[@]}" -eq 0 ]; then
    prompt "$label" "$fallback" picked
    printf -v "$var" '%s' "$picked"
    return
  fi

  info "  Available models (from OpenClaw config):"
  local idx=1 default_idx=0
  for row in "${OC_MODELS[@]}"; do
    IFS=$'\t' read -r key usable provider base <<< "$row"
    local tag
    case "$usable" in
      yes) tag="[ok] " ;;
      cli) tag="[cli]"; ;;
      no)  tag="[?]  " ;;
    esac
    info "    [$idx] $tag $key"
    if [ "$usable" = "yes" ] && [ "$default_idx" = "0" ]; then default_idx=$idx; fi
    idx=$((idx+1))
  done
  info "    [t]       type your own model name"
  info "    legend: [ok] usable from gbrain   [cli] requires Claude CLI subscription (gbrain can't call)   [?] non-Anthropic API"
  [ "$default_idx" = "0" ] && default_idx=1

  local pick=""
  prompt "$label (number or 't')" "$default_idx" pick
  if [ "$pick" = "t" ] || [ "$pick" = "T" ]; then
    prompt "  Model name" "$fallback" picked
  else
    local row="${OC_MODELS[$((pick-1))]:-}"
    if [ -z "$row" ]; then
      picked="$fallback"
    else
      IFS=$'\t' read -r key usable provider base <<< "$row"
      if [ "$prefix_mode" = "strip-prefix" ] && [[ "$key" == */* ]]; then
        picked="${key#*/}"
      else
        picked="$key"
      fi
      if [ "$usable" = "cli" ]; then
        info "  Warning: $key requires the Claude CLI subscription backend, not HTTP."
        info "  gbrain calls via the Anthropic SDK and will not be able to reach this model."
      elif [ "$usable" = "no" ]; then
        info "  Warning: $key provider is not marked anthropic-messages-compatible."
        info "  If it fails at call time, flip back to 'paste-key' in Step 3 or pick another."
      fi
    fi
  fi
  printf -v "$var" '%s' "$picked"
}

verify_openai() {
  local key="$1"
  [ -z "$key" ] && return 0
  if ! command -v curl >/dev/null 2>&1; then return 0; fi
  local status
  status="$(curl -sS -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer $key" \
    -H "Content-Type: application/json" \
    --data '{"model":"text-embedding-3-large","input":"ping"}' \
    https://api.openai.com/v1/embeddings 2>/dev/null || true)"
  case "$status" in
    200) info "  ✓ OpenAI key works for embeddings" ;;
    401) info "  ✗ OpenAI key rejected (401 Unauthorized). Check for typos or revoked keys." ;;
    403) info "  ✗ OpenAI key scoped too narrowly (403). Make sure Embeddings: Request is enabled." ;;
    000) info "  ? OpenAI reachability check failed (network). Skipping." ;;
    *)   info "  ? OpenAI probe returned HTTP $status. Not fatal, but unexpected." ;;
  esac
}

# --- commands ----------------------------------------------------------------

cmd_apply() {
  sync_default_substitutions
  local src; src="$(resolve_gbrain_src)"
  run_engine apply "$src" "$CONFIG" "$LOG" "$QUIET"
}
cmd_check() {
  sync_default_substitutions
  local src; src="$(resolve_gbrain_src)"
  run_engine check "$src" "$CONFIG" "$LOG" "0"
}
cmd_revert() {
  ensure_config
  local src; src="$(resolve_gbrain_src)"
  run_engine revert "$src" "$CONFIG" "$LOG" "$QUIET"
}
cmd_edit()    { ensure_config; open_in_editor "$CONFIG"; }
cmd_env_cmd() { touch "$ENV_FILE"; chmod 600 "$ENV_FILE"; open_in_editor "$ENV_FILE"; }
cmd_locate()  { resolve_gbrain_src; }

cmd_update() {
  if [ ! -d "$PATCHKIT_HOME/.git" ]; then
    err "not a git clone. Re-run the curl installer to update."
    exit 1
  fi
  git -C "$PATCHKIT_HOME" pull --ff-only
}

cmd_post_upgrade() {
  sync_default_substitutions

  local src=""
  if src="$(resolve_gbrain_src 2>/dev/null)"; then
    say "[post-upgrade] gbrain source: $src"
    refresh_preload_exports "$src"
    say "[post-upgrade] refreshed runtime override pointers"
    run_engine apply "$src" "$CONFIG" "$LOG" "$QUIET" || {
      local rc=$?
      err "[post-upgrade] enabled source patches need attention (exit $rc). Run: gbrain-patchkit check"
      return "$rc"
    }
    smoke_test_preload "$src" || true
    if [ -f "$OVERLAY_PATCH" ]; then
      say "[post-upgrade] applying git overlay patch"
      cmd_overlay_apply || {
        local rc=$?
        err "[post-upgrade] overlay patch needs attention (exit $rc). Run: gbrain-patchkit overlay-check"
        return "$rc"
      }
    fi
  else
    err "[post-upgrade] could not locate gbrain source. Set GBRAIN_SOURCE_DIR and rerun."
    return 1
  fi
}

cmd_overlay_snapshot() {
  local src
  src="$(resolve_gbrain_src)"
  if [ ! -d "$src/.git" ]; then
    err "[overlay] $src is not a git checkout"
    exit 1
  fi
  mkdir -p "$(dirname "$OVERLAY_PATCH")"
  local tmp
  tmp="$(mktemp)"
  (
    cd "$src"
    git diff HEAD --binary
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$f" in
        src/*|test/*|tests/*|skills/*|package.json|bun.lock|bun.lockb|tsconfig.json)
          ;;
        *)
          err "[overlay] skipping untracked non-source artifact: $f"
          continue
          ;;
      esac
      git diff --binary --no-index -- /dev/null "$f" || true
    done < <(git ls-files --others --exclude-standard)
  ) > "$tmp"
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    err "[overlay] no local diff to snapshot in $src"
    exit 1
  fi
  mv "$tmp" "$OVERLAY_PATCH"
  info "[overlay] wrote $OVERLAY_PATCH"
}

overlay_reverse_check() {
  local src="$1"
  git -C "$src" apply --unidiff-zero --reverse --check "$OVERLAY_PATCH" >/dev/null 2>&1
}

overlay_forward_check() {
  local src="$1"
  git -C "$src" apply --unidiff-zero --check "$OVERLAY_PATCH" >/dev/null 2>&1
}

# The compact overlay intentionally uses zero-context hunks so it can add the
# two new files without carrying unrelated upstream changes. Refuse an unknown
# source release before applying those positional hunks; that makes upstream
# drift loud instead of risking an insertion at the wrong location.
require_overlay_base() {
  local src="$1" version=""
  [ -f "$src/VERSION" ] && version="$(tr -d '[:space:]' < "$src/VERSION")"
  if [ "$version" != "0.46.30.0" ]; then
    err "[overlay] unsupported gbrain version: ${version:-unknown}"
    err "[overlay] this Codex overlay is verified for 0.46.30.0 only; update patchkit for your gbrain release."
    return 3
  fi
}

cmd_overlay_check() {
  local src
  src="$(resolve_gbrain_src)"
  if [ ! -f "$OVERLAY_PATCH" ]; then
    err "[overlay] missing patch: $OVERLAY_PATCH"
    exit 1
  fi
  info "[overlay] source: $src"
  info "[overlay] patch:  $OVERLAY_PATCH"
  if overlay_reverse_check "$src"; then
    info "[overlay] status: applied"
  elif ! require_overlay_base "$src"; then
    return $?
  elif overlay_forward_check "$src"; then
    info "[overlay] status: unpatched/applicable"
  else
    info "[overlay] status: drifted or partially applied"
    info "[overlay] hint: run git -C $src apply --check $OVERLAY_PATCH for details"
    exit 3
  fi
}

cmd_overlay_apply() {
  local src
  src="$(resolve_gbrain_src)"
  if [ ! -f "$OVERLAY_PATCH" ]; then
    err "[overlay] missing patch: $OVERLAY_PATCH"
    exit 1
  fi
  if overlay_reverse_check "$src"; then
    info "[overlay] already applied"
    return 0
  fi
  require_overlay_base "$src"
  info "[overlay] applying $OVERLAY_PATCH"
  if overlay_forward_check "$src"; then
    git -C "$src" apply --unidiff-zero --whitespace=nowarn "$OVERLAY_PATCH"
  else
    git -C "$src" apply --unidiff-zero --whitespace=nowarn "$OVERLAY_PATCH"
  fi
  info "[overlay] applied"
}

cmd_overlay_revert() {
  local src
  src="$(resolve_gbrain_src)"
  if [ ! -f "$OVERLAY_PATCH" ]; then
    err "[overlay] missing patch: $OVERLAY_PATCH"
    exit 1
  fi
  if overlay_forward_check "$src"; then
    info "[overlay] already unpatched"
    return 0
  fi
  info "[overlay] reverting $OVERLAY_PATCH"
  git -C "$src" apply --unidiff-zero --reverse --whitespace=nowarn "$OVERLAY_PATCH"
  info "[overlay] reverted"
}

git_unmerged_paths() {
  local src="$1"
  git -C "$src" diff --name-only --diff-filter=U 2>/dev/null || true
}

upgrade_print_unmerged_conflicts() {
  local src="$1"
  local phase="${2:-during upgrade}"
  local paths
  paths="$(git_unmerged_paths "$src")"
  [ -n "$paths" ] || return 1

  err "[upgrade] unresolved merge state detected $phase:"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    err "[upgrade]   $path"
  done <<< "$paths"
  err "[upgrade] Git cannot safely stash, pull, or apply overlays while the index has unmerged paths."
  err "[upgrade] Resolve the conflicts manually, or try: gbrain-patchkit repair-upgrade"
  err "[upgrade] Then rerun: gbrain-patchkit upgrade"
  return 0
}

upgrade_abort_if_unmerged() {
  local src="$1"
  local phase="${2:-before upgrade}"
  if upgrade_print_unmerged_conflicts "$src" "$phase"; then
    exit 1
  fi
}

repair_resolver_conflict() {
  local src="$1"
  local path="skills/RESOLVER.md"
  local file="$src/$path"
  [ -f "$file" ] || return 1
  grep -q '^<<<<<<< ' "$file" || return 1
  grep -q '^>>>>>>> ' "$file" || return 1

  local tmp
  tmp="$(mktemp)"
  if ! awk '
    function skill_key(line, parts, n, i, key) {
      n = split(line, parts, "`")
      key = ""
      for (i = 2; i <= n; i += 2) {
        if (parts[i] ~ /SKILL\.md$/) key = parts[i]
      }
      return key
    }
    function add_conflict_line(line, key, idx) {
      if (line == "") {
        if (!blank_seen++) merged[++merged_count] = line
        return
      }
      key = skill_key(line)
      if (key != "") {
        if (key in key_index) {
          idx = key_index[key]
          if (length(line) > length(merged[idx])) merged[idx] = line
          return
        }
        key_index[key] = ++merged_count
        merged[merged_count] = line
        return
      }
      if (!literal_seen[line]++) merged[++merged_count] = line
    }
    function flush_conflict(i) {
      delete key_index
      delete literal_seen
      delete merged
      merged_count = 0
      blank_seen = 0
      for (i = 1; i <= left_count; i++) add_conflict_line(left[i])
      for (i = 1; i <= right_count; i++) add_conflict_line(right[i])
      for (i = 1; i <= merged_count; i++) print merged[i]
    }
    BEGIN { in_conflict = 0; side = 0; left_count = 0; right_count = 0 }
    /^<<<<<<< / { in_conflict = 1; side = 1; left_count = 0; right_count = 0; next }
    in_conflict && /^=======$/ { side = 2; next }
    in_conflict && /^>>>>>>> / {
      flush_conflict()
      delete left
      delete right
      in_conflict = 0
      side = 0
      next
    }
    in_conflict {
      if (side == 1) left[++left_count] = $0
      else right[++right_count] = $0
      next
    }
    { print }
    END { if (in_conflict) exit 2 }
  ' "$file" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  if grep -qE '^(<<<<<<<|=======|>>>>>>>)' "$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  mv "$tmp" "$file"
  git -C "$src" add "$path"
}

repair_known_overlay_conflict() {
  local src="$1"
  local path="$2"
  local strategy="$3"
  local file="$src/$path"
  [ -f "$file" ] || return 1
  grep -q '^<<<<<<< ' "$file" || return 1
  grep -q '^>>>>>>> ' "$file" || return 1

  local tmp
  tmp="$(mktemp)"
  if ! python3 - "$file" "$path" "$strategy" > "$tmp" <<'PY'
import pathlib
import re
import sys

file = pathlib.Path(sys.argv[1])
path = sys.argv[2]
strategy = sys.argv[3]
text = file.read_text()

conflict_re = re.compile(r"^<<<<<<< [^\n]*\n(.*?)^=======\n(.*?)^>>>>>>> [^\n]*(?:\n|$)", re.M | re.S)
incoming_fs = "import { existsSync, readFileSync, readdirSync, realpathSync, statSync } from 'fs';"
current_fs = "import { existsSync, readFileSync, readdirSync, statSync } from 'fs';"

def ensure_newline(s):
    return s if s.endswith("\n") else s + "\n"

def resolve_doctor(current, incoming):
    # Older upgrade conflict: upstream added doctor imports while the overlay
    # carried the fs realpathSync import. Keep upstream and splice in realpathSync.
    if (
        "extractEntityRefs" in current
        and "buildVisibilityClause" in current
        and incoming_fs in incoming
    ):
        replacement = current.replace(current_fs, incoming_fs, 1)
        if incoming_fs not in replacement:
            raise ValueError("doctor import conflict missing fs replacement")
        return ensure_newline(replacement)

    # Current upgrade conflict: upstream added context/reflex imports; stashed
    # side was empty in that area.
    if "reflexEnabled" in current and "resolveSocketPath" in current and "homedir" in current:
        return ensure_newline(current)

    # Current upgrade conflict: upstream broadened gateway-loop config parsing;
    # stashed side still had the older true/1-only check.
    if "gatewayLoopEnabled" in current and "useGatewayLoop" in incoming:
        return ensure_newline(current)

    raise ValueError("unknown doctor conflict shape")

def resolve_union_lines(current, incoming):
    merged = []
    seen = set()
    for line in current.splitlines() + incoming.splitlines():
        if line not in seen:
            seen.add(line)
            merged.append(line)
    return "\n".join(merged) + "\n"

def resolve_keep_updated(current, incoming):
    if path == "src/core/pglite-engine.ts":
        ok = "sourceIds" in current and "SELECT DISTINCT tag" in current and "page_id IN" in current
    elif path == "src/core/postgres-engine.ts":
        ok = "SELECT DISTINCT tag" in current and "page_id IN" in current
    elif path == "src/core/pglite-lock.ts":
        ok = (
            "HEARTBEAT_INTERVAL_MS" in current
            or "stealGraceMs" in current
            or "sinceRefresh" in current
        )
    else:
        ok = False
    if not ok:
        raise ValueError(f"unknown keep-updated conflict shape in {path}")
    return ensure_newline(current)

def resolve_hunk(current, incoming):
    if strategy == "doctor":
        return resolve_doctor(current, incoming)
    if strategy == "union-lines":
        return resolve_union_lines(current, incoming)
    if strategy == "keep-updated":
        return resolve_keep_updated(current, incoming)
    raise ValueError(f"unknown strategy {strategy}")

parts = []
pos = 0
count = 0
try:
    for m in conflict_re.finditer(text):
        current, incoming = m.group(1), m.group(2)
        parts.append(text[pos:m.start()])
        parts.append(resolve_hunk(current, incoming))
        pos = m.end()
        count += 1
except ValueError:
    sys.exit(1)

if count == 0:
    sys.exit(1)

parts.append(text[pos:])
new_text = "".join(parts)
if "loadConfig(" in new_text and "import { gbrainPath, loadConfig } from '../core/config.ts';" not in new_text:
    new_text = new_text.replace(
        "import { gbrainPath } from '../core/config.ts';",
        "import { gbrainPath, loadConfig } from '../core/config.ts';",
        1,
    )
if "realpathSync(" in new_text and incoming_fs not in new_text:
    new_text = new_text.replace(current_fs, incoming_fs, 1)
if re.search(r"^(<<<<<<<|=======|>>>>>>>)", new_text, re.M):
    sys.exit(1)
sys.stdout.write(new_text)
PY
  then
    rm -f "$tmp"
    return 1
  fi

  if grep -qE '^(<<<<<<<|=======|>>>>>>>)' "$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  mv "$tmp" "$file"
  git -C "$src" add "$path"
}

cmd_repair_upgrade() {
  local src
  if ! src="$(resolve_gbrain_src)"; then
    err "[repair-upgrade] could not resolve gbrain source dir; set GBRAIN_SOURCE_DIR or install gbrain"
    exit 1
  fi
  if [ ! -d "$src/.git" ]; then
    err "[repair-upgrade] $src is not a git checkout"
    exit 1
  fi

  local paths
  paths="$(git_unmerged_paths "$src")"
  if [ -z "$paths" ]; then
    info "[repair-upgrade] no unmerged paths found in $src"
    return 0
  fi

  local repaired=0
  local unsupported=0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      skills/RESOLVER.md)
        info "[repair-upgrade] repairing $path by keeping both conflict sides"
        if repair_resolver_conflict "$src"; then
          repaired=1
        else
          err "[repair-upgrade] could not safely repair $path"
          unsupported=1
        fi
        ;;
      src/commands/doctor.ts)
        info "[repair-upgrade] repairing $path by merging known-safe doctor overlay conflicts"
        if repair_known_overlay_conflict "$src" "$path" doctor; then
          repaired=1
        else
          err "[repair-upgrade] could not safely repair $path"
          unsupported=1
        fi
        ;;
      src/core/doctor-categories.ts)
        info "[repair-upgrade] repairing $path by keeping both category names"
        if repair_known_overlay_conflict "$src" "$path" union-lines; then
          repaired=1
        else
          err "[repair-upgrade] could not safely repair $path"
          unsupported=1
        fi
        ;;
      src/core/pglite-engine.ts|src/core/pglite-lock.ts|src/core/postgres-engine.ts)
        info "[repair-upgrade] repairing $path by keeping the updated upstream implementation"
        if repair_known_overlay_conflict "$src" "$path" keep-updated; then
          repaired=1
        else
          err "[repair-upgrade] could not safely repair $path"
          unsupported=1
        fi
        ;;
      *)
        err "[repair-upgrade] no automatic repair rule for $path"
        unsupported=1
        ;;
    esac
  done <<< "$paths"

  local remaining
  remaining="$(git_unmerged_paths "$src")"
  if [ -n "$remaining" ]; then
    err "[repair-upgrade] unresolved paths remain:"
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      err "[repair-upgrade]   $path"
    done <<< "$remaining"
    err "[repair-upgrade] Resolve those manually, then rerun: gbrain-patchkit upgrade"
    exit 1
  fi

  if [ "$repaired" = "1" ]; then
    info "[repair-upgrade] repaired known conflicts and staged the resolution"
    info "[repair-upgrade] review with: git -C $src diff --cached"
    info "[repair-upgrade] then rerun: gbrain-patchkit upgrade"
  elif [ "$unsupported" = "1" ]; then
    exit 1
  fi
}

# Upgrade the user's gbrain checkout end-to-end: stash → git pull → bun install →
# stash pop → gbrain post-upgrade. The stash dance handles bun-link's cli.ts mode
# flip transparently so the user never has to touch ~/gbrain themselves.
cmd_upgrade() {
  # Don't suppress stderr — if GBRAIN_SOURCE_DIR is set wrong, the user needs
  # to see exactly why resolve_gbrain_src rejected it.
  local src
  if ! src="$(resolve_gbrain_src)"; then
    err "[upgrade] could not resolve gbrain source dir; set GBRAIN_SOURCE_DIR or install gbrain"
    exit 1
  fi
  if [ ! -d "$src/.git" ]; then
    err "[upgrade] $src is not a git checkout. Use \`bun update gbrain\` for non-git installs."
    exit 1
  fi
  if ! command -v git >/dev/null 2>&1; then
    err "[upgrade] git not on PATH"; exit 1
  fi

  info "[upgrade] gbrain source: $src"
  upgrade_abort_if_unmerged "$src" "before upgrade"

  # 0. If the git overlay is currently applied, remove it before pulling.
  # Reapplying the overlay after the pull gives git a clean upstream base and
  # avoids stash-pop conflicts for our own maintained changes.
  local overlay_removed=0
  if [ -f "$OVERLAY_PATCH" ] && overlay_reverse_check "$src"; then
    info "[upgrade] overlay currently applied — reverting before pull"
    cmd_overlay_revert
    overlay_removed=1
  fi

  # 1. Stash any remaining working-tree dirt (user edits, mode flips, etc.).
  local stashed=0
  local stash_msg="gbrain-patchkit-upgrade-$(date +%s)"
  if [ -n "$(git -C "$src" status --porcelain)" ]; then
    info "[upgrade] working tree dirty — stashing before pull (label: $stash_msg)"
    if git -C "$src" stash push --include-untracked --quiet -m "$stash_msg"; then
      stashed=1
    else
      err "[upgrade] git stash failed; aborting"
      if [ "$overlay_removed" = "1" ]; then cmd_overlay_apply || true; fi
      exit 1
    fi
  else
    info "[upgrade] working tree clean"
  fi

  # 2. Pull (ff-only — refuse to auto-merge divergent histories).
  info "[upgrade] git pull --ff-only origin master"
  if ! git -C "$src" pull --ff-only origin master; then
    err "[upgrade] git pull failed."
    if [ "$stashed" = "1" ]; then
      err "[upgrade]   your stashed changes are at: stash@{0} ($stash_msg)"
      err "[upgrade]   restore with: git -C $src stash pop"
    fi
    if [ "$overlay_removed" = "1" ]; then
      err "[upgrade]   re-applying overlay so your local gbrain keeps working"
      cmd_overlay_apply || true
    fi
    exit 1
  fi

  # 3. Bun install (re-flips cli.ts mode bit; pulls any new deps).
  #    --ignore-scripts: gbrain's postinstall runs `gbrain apply-migrations`,
  #    but Bun 1.3's lifecycle-script sandbox blocks executing binaries
  #    outside the project tree (~/.bun/bin/gbrain → "Permission denied").
  #    We invoke `gbrain post-upgrade` explicitly in step 5 below, which
  #    runs apply-migrations itself — so the postinstall is redundant.
  info "[upgrade] bun install --ignore-scripts"
  if ! (cd "$src" && bun install --ignore-scripts); then
    err "[upgrade] bun install failed; continuing (you may need to fix manually)"
  fi

  # 4. Pop the stash. cli.ts mode-flip stashes typically pop cleanly because
  #    the working tree (after bun install) already matches the stashed mode.
  #    Real conflicts mean the user had non-trivial dirt — leave it stashed.
  if [ "$stashed" = "1" ]; then
    info "[upgrade] restoring stash"
    if git -C "$src" stash pop --quiet 2>/dev/null; then
      info "[upgrade] ✓ stash restored cleanly"
    else
      # Pop failed (conflict) OR succeeded but reported nothing-to-do.
      if upgrade_print_unmerged_conflicts "$src" "after restoring stash"; then
        if git -C "$src" stash list 2>/dev/null | grep -qF "$stash_msg"; then
          err "[upgrade]   your stashed changes are still in the stash list (search for $stash_msg)"
        fi
        exit 1
      fi
      # Check if the stash is still in the list — if so, conflict.
      if git -C "$src" stash list 2>/dev/null | grep -qF "$stash_msg"; then
        err "[upgrade] ⚠ stash pop hit a conflict; your changes are still in:"
        err "[upgrade]   git -C $src stash list   # search for $stash_msg"
        err "[upgrade]   Resolve manually with: git -C $src stash pop"
        err "[upgrade]   Then rerun: gbrain-patchkit upgrade"
        exit 1
      else
        info "[upgrade] ✓ stash absorbed (no-op pop — bun install already restored the state)"
      fi
    fi
  fi

  # 5. Run gbrain post-upgrade so migrations + features refresh land.
  info "[upgrade] gbrain post-upgrade"
  if command -v gbrain >/dev/null 2>&1; then
    # Source env.sh so post-upgrade has the user's keys + GBRAIN_SOURCE_DIR.
    if [ -f "$ENV_FILE" ]; then
      # shellcheck disable=SC1090
      ( . "$ENV_FILE" && gbrain post-upgrade ) || info "[upgrade] gbrain post-upgrade returned non-zero (non-fatal)"
    else
      gbrain post-upgrade || info "[upgrade] gbrain post-upgrade returned non-zero (non-fatal)"
    fi
  else
    info "[upgrade] gbrain not on PATH; skipping post-upgrade"
  fi

  info "[upgrade] gbrain-patchkit post-upgrade"
  cmd_post_upgrade || info "[upgrade] patchkit post-upgrade returned non-zero (inspect with gbrain-patchkit check)"

  info ""
  info "[upgrade] ✓ done. cd $src && git status   # should be clean (modulo cli.ts mode if you declined the migrate fix)"
}

cmd_bootstrap() {
  ensure_config
  info ""
  info "=================================================================="
  info "  gbrain-patchkit onboard — zero-input current overlay setup"
  info "=================================================================="
  info ""

  local src
  if ! src="$(resolve_gbrain_src 2>/dev/null)"; then
    err "[onboard] could not locate gbrain."
    err "[onboard] Install gbrain first, or set GBRAIN_SOURCE_DIR=/path/to/gbrain and rerun."
    exit 1
  fi
  info "[onboard] gbrain source: $src"

  if [ -f "$ENV_FILE" ]; then
    refresh_preload_exports "$src"
    info "[onboard] refreshed runtime override pointers in $ENV_FILE"
  else
    write_minimal_env_file "$src"
    info "[onboard] wrote runtime-only env file at $ENV_FILE"
  fi

  # Keep the freshly detected source available to helper commands in this
  # process, even before the caller reloads their shell.
  GBRAIN_SOURCE_DIR="$src"
  export GBRAIN_SOURCE_DIR

  install_shell_hook
  install_path_shim
  sync_default_substitutions
  : > "$LOG" 2>/dev/null || true

  info ""
  info "[onboard] source-patch substitutions"
  run_engine apply "$src" "$CONFIG" "$LOG" "$QUIET" || {
    local rc=$?
    err "[onboard] enabled source patches need attention (exit $rc). Run: gbrain-patchkit check"
    return "$rc"
  }

  smoke_test_preload "$src" || true

  if [ -f "$OVERLAY_PATCH" ]; then
    info ""
    info "[onboard] applying git overlay patch"
    cmd_overlay_apply || {
      local rc=$?
      err "[onboard] overlay patch needs attention (exit $rc). Run: gbrain-patchkit overlay-check"
      return "$rc"
    }
  fi

  info ""
  info "=================================================================="
  info "  Setup complete."
  info "=================================================================="
  info ""
  info "No API keys or model names are required for the current Codex CLI overlay."
  info "Reload your shell to pick up the hook, then verify:"
  info "  exec \$SHELL -l"
  info "  gbrain-patchkit overlay-check"
  info "  gbrain-patchkit doctor"
  info ""
  info "Optional provider keys/models are now a manual choice. Add them with:"
  info "  gbrain-patchkit env"
}

cmd_install() {
  cmd_bootstrap
}

cmd_configure_codex_deepseek() {
  local profile="${FLAGS[1]:-}"
  if [ "$profile" != "codex-deepseek" ]; then
    err "usage: gbrain-patchkit configure codex-deepseek [--prompt]"
    err "set DEEPSEEK_API_KEY in the command environment, or pass --prompt in a terminal"
    return 2
  fi

  local key="${DEEPSEEK_API_KEY:-}" prompt_for_key=0 flag
  for flag in "${FLAGS[@]:2}"; do
    [ "$flag" = "--prompt" ] && prompt_for_key=1
  done
  if [ -z "$key" ] && [ "$prompt_for_key" = "1" ]; then
    prompt_secret "Paste DeepSeek API key" key
  fi
  if [ -z "$key" ]; then
    err "[configure] DEEPSEEK_API_KEY is required. Example:"
    err "  DEEPSEEK_API_KEY='...' gbrain-patchkit configure codex-deepseek"
    return 2
  fi
  if ! command -v codex >/dev/null 2>&1; then
    err "[configure] Codex CLI is not on PATH. Install it and log in before applying this profile."
    return 1
  fi

  local src
  src="$(resolve_gbrain_src)"
  GBRAIN_SOURCE_DIR="$src"
  export GBRAIN_SOURCE_DIR
  if [ -f "$ENV_FILE" ]; then
    refresh_preload_exports "$src"
  else
    write_minimal_env_file "$src"
  fi
  install_shell_hook
  install_path_shim

  # The API key belongs in patchkit's private environment file, not in
  # GBrain's config database. GBrain's native config stores only model routes.
  DEEPSEEK_API_KEY="$key" python3 - "$ENV_FILE" <<'PY'
import os, pathlib, re, shlex, sys
path = pathlib.Path(sys.argv[1])
value = os.environ["DEEPSEEK_API_KEY"]
text = path.read_text() if path.exists() else "# ~/.gbrain-patchkit/env.sh\n"
line = f"export DEEPSEEK_API_KEY={shlex.quote(value)}"
pattern = r"(?m)^export DEEPSEEK_API_KEY=.*$"
text = re.sub(pattern, line, text) if re.search(pattern, text) else text.rstrip() + "\n\n# DeepSeek key used only by gbrain.\n" + line + "\n"
path.write_text(text)
PY
  chmod 600 "$ENV_FILE"
  export DEEPSEEK_API_KEY="$key"
  unset key

  info "[configure] applying current Codex overlay to $src"
  cmd_overlay_apply

  # Use GBrain's own persistent config surface for every route. DeepSeek owns
  # tool-capable work; Codex subscription calls are limited to non-tool work.
  local routes=(
    "agent.use_gateway_loop true"
    "models.tier.utility deepseek:deepseek-v4-flash"
    "models.tier.reasoning deepseek:deepseek-v4-flash"
    "models.tier.deep deepseek:deepseek-v4-flash"
    "models.expansion deepseek:deepseek-v4-flash"
    "models.chat deepseek:deepseek-v4-flash"
    "models.subagent deepseek:deepseek-v4-flash"
    "models.tier.subagent deepseek:deepseek-v4-flash"
    "models.dream.patterns deepseek:deepseek-v4-flash"
    "models.dream.synthesize deepseek:deepseek-v4-flash"
    "facts.extraction_model deepseek:deepseek-v4-flash"
    "models.drift deepseek:deepseek-v4-flash"
    "models.eval.longmemeval deepseek:deepseek-v4-flash"
    "models.eval.contradictions_judge deepseek:deepseek-v4-flash"
    "models.think codex:gpt-5.6"
    "models.auto_think codex:gpt-5.6"
    "models.dream.triage codex:gpt-5.6"
    "models.dream.synthesize_verdict codex:gpt-5.6"
  )
  local route config_key config_value
  for route in "${routes[@]}"; do
    config_key="${route%% *}"
    config_value="${route#* }"
    gbrain config set "$config_key" "$config_value"
  done

  info "[configure] profile applied: Codex for non-tool thinking; DeepSeek for gateway chat, subagents, and Dream patterns."
  info "[configure] next: gbrain-patchkit doctor"
}

cmd_uninstall() {
  remove_shell_hook
  info ""
  info "Hook removed. Your env file, config, and install dir are still at:"
  info "  $ENV_FILE"
  info "  $CONFIG"
  info "  $PATCHKIT_HOME"
  info "Delete them manually if you want a clean wipe:  rm -rf $PATCHKIT_HOME"
}

cmd_doctor() {
  info "[doctor] tool home:       $PATCHKIT_HOME"
  info "[doctor] config:          $([ -f "$CONFIG" ] && echo present || echo MISSING)"
  info "[doctor] env file:        $([ -f "$ENV_FILE" ] && echo present || echo MISSING)"
  info "[doctor] preload file:    $([ -f "$PRELOAD_FILE" ] && echo present || echo MISSING)"
  # Source env file locally for the probe if it exists
  if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE"
  fi
  local vars=(DEEPSEEK_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY ANTHROPIC_BASE_URL GBRAIN_EXPANSION_MODEL GBRAIN_SUBAGENT_MODEL GBRAIN_THINK_MODEL GBRAIN_ANTHROPIC_MODEL_MAP GBRAIN_SOURCE_DIR GBRAIN_ENTRY GBRAIN_OVERRIDE_JS)
  for v in "${vars[@]}"; do
    local val="${!v-}"
    if [ -z "$val" ]; then
      printf '  %-26s (unset)\n' "$v"
    elif [[ "$v" == *_API_KEY ]]; then
      printf '  %-26s %s\n' "$v" "$(mask "$val")"
    else
      printf '  %-26s %s\n' "$v" "$val"
    fi
  done
  info ""
  if command -v gbrain >/dev/null 2>&1; then
    local gbrain_cmd gbrain_real patchkit_real
    gbrain_cmd="$(command -v gbrain)"
    gbrain_real="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$gbrain_cmd" 2>/dev/null || printf '%s' "$gbrain_cmd")"
    patchkit_real="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$PATCHKIT_HOME" 2>/dev/null || printf '%s' "$PATCHKIT_HOME")"
    info "[doctor] gbrain on PATH:  $gbrain_cmd"
    if [[ "$gbrain_real" == "$patchkit_real/bin/gbrain" || "$gbrain_real" == "$PATCHKIT_HOME/bin/gbrain" ]]; then
      info "[doctor] upgrade hook:   ✓ patchkit shim will run post-upgrade overlay replay"
    else
      info "[doctor] upgrade hook:   ⚠ native gbrain is ahead of patchkit on PATH"
      info "                         Use \`gbrain-patchkit upgrade\`, or put $PATCHKIT_HOME/bin before native gbrain so \`gbrain upgrade\` replays the overlay."
    fi
  else
    info "[doctor] gbrain on PATH:  (not found)"
  fi
  info ""

  # Runtime-override smoke test — replaces the old marker-based drift check
  # for the default model substitutions.
  info "[doctor] runtime override:"
  local src=""
  if src="$(resolve_gbrain_src 2>/dev/null)"; then
    if smoke_test_preload "$src"; then
      info "  ✓ SDK present, Messages.prototype.create resolved"
    fi
  else
    info "  (gbrain source not located — can't probe SDK shape)"
  fi
  info ""

  info "[doctor] source-patch substitutions:"
  cmd_check || true
}

cmd_migrate() {
  local non_interactive=0
  for f in "${FLAGS[@]:-}"; do
    [ "$f" = "--non-interactive" ] && non_interactive=1
  done

  ensure_config
  info ""
  info "=================================================================="
  info "  gbrain-patchkit migrate — switch to runtime SDK override"
  info "=================================================================="
  info ""
  info "  Retires source-patch mechanism for the default model substitutions."
  info "  Reverts any active patches in ~/gbrain, disables the defaults in"
  info "  substitutions.json, and wires runtime override pointers into env.sh so the"
  info "  Anthropic SDK is patched in-process at every gbrain call."
  info ""

  local src=""
  if src="$(resolve_gbrain_src 2>/dev/null)"; then
    info "[migrate] gbrain source: $src"
  else
    info "[migrate] gbrain source not located (set GBRAIN_SOURCE_DIR to override)"
    info "[migrate]   skipping source-patch revert; env + preload setup will still run"
  fi
  info ""

  # 1. Revert any active source patches. Idempotent: unpatched files are skipped.
  if [ -n "$src" ]; then
    info "[migrate] reverting any active source patches"
    run_engine revert "$src" "$CONFIG" "$LOG" "0" || true
    info ""
  fi

  # 2. Disable the two default substitutions in user's config (preserves
  #    any custom substitutions the user added).
  python3 - "$CONFIG" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
try:
    cfg = json.loads(p.read_text())
except Exception as e:
    print(f"[migrate] could not parse {p}: {e}", file=sys.stderr); sys.exit(0)
DEFAULT_MARKERS = {"GBRAIN_EXPANSION_MODEL", "GBRAIN_SUBAGENT_MODEL"}
changed = False
for s in cfg.get("substitutions", []):
    if s.get("marker") in DEFAULT_MARKERS and s.get("enabled", True):
        s["enabled"] = False
        s["disabled_by"] = "runtime-override"
        changed = True
if changed:
    p.write_text(json.dumps(cfg, indent=2) + "\n")
    print(f"[migrate] disabled default source substitutions in {p}")
else:
    print(f"[migrate] default substitutions already disabled in {p}")
PY
  info ""

  # 3. Make sure the preload file is present in the install dir.
  if [ ! -f "$PRELOAD_FILE" ]; then
    err "[migrate] preload file missing: $PRELOAD_FILE"
    err "[migrate]   run \`gbrain-patchkit update\` to pull it in, then re-run migrate"
    exit 1
  fi

  # 4. Append runtime override exports to env.sh (idempotent).
  ensure_preload_export "$src"
  info ""

  # 5. Refresh shell hook and command shim (idempotent).
  install_shell_hook
  install_path_shim
  info ""

  # 6. SDK shape smoke test.
  if [ -n "$src" ]; then
    smoke_test_preload "$src" || true
    info ""
  fi

  # 7. Optional cli.ts mode-flip fix (consent prompt, default N).
  if [ "$non_interactive" = "1" ]; then
    info "[migrate] skipped optional cli.ts mode fix in non-interactive mode"
  else
    offer_clits_fix "$src"
  fi

  info ""
  info "=================================================================="
  info "  Migration complete."
  info "=================================================================="
  info ""
  info "  Open a new shell or run:  exec \$SHELL -l"
  info "  Then verify:              gbrain-patchkit doctor"
  info "  Non-interactive callers:  ensure ~/.local/bin appears before the native gbrain bin on PATH"
  info ""
  info "  Your next \`cd ~/gbrain && git pull origin master && bun install\`"
  info "  should run without conflict (modulo the cli.ts mode bit if you"
  info "  declined the fix above)."
  info ""
}

cmd_onboard() {
  local interactive=0
  for f in "${FLAGS[@]:-}"; do
    case "$f" in
      --interactive|--reconfigure) interactive=1 ;;
    esac
  done
  if [ "$interactive" != "1" ]; then
    cmd_bootstrap
    return
  fi

  local reconfigure=0
  for f in "${FLAGS[@]:-}"; do
    [ "$f" = "--reconfigure" ] && reconfigure=1
  done

  info ""
  info "=================================================================="
  info "  gbrain-patchkit interactive provider setup"
  info "=================================================================="
  info ""
  info "This optional wizard will:"
  info "  1. Locate your gbrain install"
  info "  2. Collect API keys (OpenAI for embeddings; MiniMax/etc for LLM)"
  info "  3. Collect an Anthropic-compatible base URL + model names"
  info "  4. Write env file (with runtime override pointers)"
  info "  5. Install the shell hook + verify the SDK shape"
  info "  6. Verify everything"
  info ""
  info "  NOTE: gbrain-patchkit no longer modifies ~/gbrain source files for"
  info "  the model substitutions. anthropic-override.js (a Bun preload) does"
  info "  the swap at SDK call time, so \`git pull\` in ~/gbrain just works."
  info ""
  info "The current Codex CLI overlay does not require these keys. This wizard is"
  info "only for optional embedding/Anthropic-compatible provider setup."
  info "All keys are stored in $ENV_FILE with 600 perms. Nothing leaves your machine."
  info ""

  # --- Step 1: locate gbrain ---
  info "Step 1/6  Locate gbrain"
  local src=""
  if src="$(resolve_gbrain_src 2>/dev/null)"; then
    info "  ✓ Found gbrain source at: $src"
  else
    info "  ✗ gbrain not found on PATH."
    info "    Install it first:  bun install -g github:garrytan/gbrain"
    info "    Or export GBRAIN_SOURCE_DIR=/path/to/your/gbrain checkout and re-run onboard."
    exit 1
  fi
  info ""

  # --- Detect existing auth on this machine ---
  detect_existing_auth

  # --- Step 2: OpenAI key ---
  info "Step 2/6  OpenAI API key (for embeddings — required for vector search)"
  local openai=""
  if [ "$DET_OPENAI_SET" = "1" ]; then
    info "  [detected] OPENAI_API_KEY already set in your environment: $DET_OPENAI_MASKED"
    local reuse=""
    prompt "Reuse it? [Y/n]" "Y" reuse
    case "$reuse" in
      n|N|no|No|NO)
        prompt_secret "Paste a new OpenAI key (sk-...) or leave blank to skip" openai ;;
      *)
        openai="$OPENAI_API_KEY"
        info "  ✓ keeping $DET_OPENAI_MASKED" ;;
    esac
  else
    info "  Create a RESTRICTED key with only 'Embeddings: Request' enabled:"
    info "    https://platform.openai.com/api-keys"
    info "  Leave blank to skip (gbrain falls back to keyword-only search)."
    prompt_secret "OpenAI API key (sk-...)" openai
    [ -n "$openai" ] && info "    got: $(mask "$openai")"
  fi
  info ""

  # --- Step 3: LLM credential (MiniMax / Anthropic-compat) with auth detection ---
  info "Step 3/6  LLM API credential (query expansion + \`gbrain agent run\`)"
  info ""
  info "  Auth scan:"
  if [ "$DET_ANTHROPIC_SET" = "1" ]; then
    info "    ✓ ANTHROPIC_API_KEY already set ($DET_ANTHROPIC_MASKED)"
    [ -n "$DET_ANTHROPIC_BASE" ] && info "      with ANTHROPIC_BASE_URL=$DET_ANTHROPIC_BASE"
  fi
  if [ "$DET_OPENCLAW_PRESENT" = "1" ]; then
    info "    ✓ OpenClaw config at ~/.openclaw/openclaw.json"
    [ -n "$DET_OPENCLAW_GATEWAY_PORT" ] && info "      gateway on loopback:$DET_OPENCLAW_GATEWAY_PORT"
    [ "$DET_OPENCLAW_GATEWAY_TOKEN_SET" = "1" ] && info "      OPENCLAW_GATEWAY_TOKEN is set"
    if [ "$DET_OPENCLAW_MINIMAX_MODE" = "oauth" ]; then
      info "      minimax-portal auth = oauth (NOTE: OAuth tokens are NOT portable to gbrain)"
    fi
  fi
  if [ "$DET_ANTHROPIC_SET" = "0" ] && [ "$DET_OPENCLAW_PRESENT" = "0" ]; then
    info "    (no existing LLM auth detected on this machine)"
  fi
  info ""

  # Build menu of choices
  local choices=()
  local default_choice=""
  if [ "$DET_ANTHROPIC_SET" = "1" ]; then
    choices+=("reuse-anthropic"); default_choice="${default_choice:-reuse-anthropic}"
  fi
  if [ "$DET_OPENCLAW_GATEWAY_TOKEN_SET" = "1" ] && [ -n "$DET_OPENCLAW_GATEWAY_PORT" ]; then
    choices+=("openclaw-gateway"); default_choice="${default_choice:-openclaw-gateway}"
  fi
  choices+=("paste-key")
  choices+=("skip")
  default_choice="${default_choice:-paste-key}"

  info "  Pick credential source:"
  local idx=1 default_idx=0
  for c in "${choices[@]}"; do
    case "$c" in
      reuse-anthropic)  info "    [$idx] Reuse \$ANTHROPIC_API_KEY ($DET_ANTHROPIC_MASKED)" ;;
      openclaw-gateway) info "    [$idx] Route through OpenClaw gateway 127.0.0.1:$DET_OPENCLAW_GATEWAY_PORT using \$OPENCLAW_GATEWAY_TOKEN" ;;
      paste-key)        info "    [$idx] Paste a static API key (MiniMax platform, direct Anthropic, etc.)" ;;
      skip)             info "    [$idx] Skip (query expansion + agent disabled; search still works)" ;;
    esac
    [ "$c" = "$default_choice" ] && default_idx=$idx
    idx=$((idx+1))
  done

  local picked=""
  prompt "Choice" "$default_idx" picked
  local choice="${choices[$((picked-1))]:-$default_choice}"
  info ""

  local minimax="" minimax_base="" exp_model="" sub_model=""
  case "$choice" in
    reuse-anthropic)
      minimax="$ANTHROPIC_API_KEY"
      info "  ✓ reusing \$ANTHROPIC_API_KEY"
      if [ -n "$DET_ANTHROPIC_BASE" ]; then
        local keep=""
        prompt "Keep existing ANTHROPIC_BASE_URL=$DET_ANTHROPIC_BASE? [Y/n]" "Y" keep
        case "$keep" in
          n|N|no|No|NO) prompt "New Anthropic-compatible base URL (blank for Anthropic default)" "" minimax_base ;;
          *)            minimax_base="$DET_ANTHROPIC_BASE" ;;
        esac
      else
        prompt "Anthropic-compatible base URL (blank = Anthropic default)" "" minimax_base
      fi
      ;;
    openclaw-gateway)
      info "  Using OPENCLAW_GATEWAY_TOKEN as the Anthropic API key."
      info "  You need the gateway path that exposes an Anthropic-compatible surface."
      info "  Check your OpenClaw docs — the full URL typically looks like"
      info "    http://127.0.0.1:$DET_OPENCLAW_GATEWAY_PORT/<some-path>"
      info ""
      minimax="$OPENCLAW_GATEWAY_TOKEN"
      prompt "Gateway Anthropic-compat URL" "http://127.0.0.1:$DET_OPENCLAW_GATEWAY_PORT/anthropic" minimax_base
      ;;
    paste-key)
      info "  For MiniMax direct: create an API key at the MiniMax platform console."
      info "  Leave blank to skip."
      prompt_secret "API key" minimax
      if [ -n "$minimax" ]; then
        info "    got: $(mask "$minimax")"
        info "  MiniMax default (verify in their docs): https://api.minimaxi.chat/anthropic"
        prompt "Anthropic-compatible base URL" "https://api.minimaxi.chat/anthropic" minimax_base
      fi
      ;;
    skip)
      info "  Skipping LLM credential."
      ;;
  esac
  info ""

  # --- Step 4: model names (only if we have an LLM key) ---
  if [ -n "$minimax" ]; then
    info "Step 4/6  Model names"
    # When routing through the OpenClaw gateway, the gateway expects
    # "provider/model" (that's how it maps to the upstream provider).
    # For direct provider endpoints (MiniMax/Anthropic), strip the prefix.
    local prefix_mode="strip-prefix"
    [ "$choice" = "openclaw-gateway" ] && prefix_mode="keep-prefix"

    info "  Query-expansion model — replaces hardcoded Claude Haiku."
    info "  Keep fast + tool-use-capable; this fires on every search ≥3 words."
    pick_model "Pick for query-expansion" exp_model "$prefix_mode" "MiniMax-M2.7-highspeed"
    info "  → exp_model = $exp_model"
    info ""

    info "  Subagent default — replaces hardcoded Claude Sonnet."
    info "  Used by \`gbrain agent run\` when no --model flag is given."
    info "  Pick a fuller-capability model here; speed matters less."
    pick_model "Pick for subagent default" sub_model "$prefix_mode" "MiniMax-M2.7"
    info "  → sub_model = $sub_model"
  else
    info "Step 4/6  (skipped — no LLM credential provided)"
  fi
  info ""

  # --- Step 5: write files + install hook + smoke-test the runtime override ---
  info "Step 5/6  Write env + install shell hook + verify runtime override"
  write_env_file "$openai" "$minimax" "$minimax_base" "$exp_model" "$sub_model"
  info "  ✓ wrote $ENV_FILE (includes runtime override pointers)"
  install_shell_hook
  install_path_shim
  sync_default_substitutions
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  # Verify the Anthropic SDK is at the path our preload hooks, then apply
  # enabled source patches for provider-neutral expansion touchpoints.
  smoke_test_preload "$src" || true
  run_engine apply "$src" "$CONFIG" "$LOG" "$QUIET" || true
  info ""

  # --- Step 6: verify ---
  info "Step 6/6  Verify"
  [ -n "$openai" ] && verify_openai "$openai"
  info ""

  # --- Done ---
  info "=================================================================="
  info "  Setup complete."
  info "=================================================================="
  info ""
  info "Your keys live in $ENV_FILE and are scoped to the \`gbrain\` command."
  info "They will NOT leak into Claude Code, codex, or other Anthropic-SDK tools"
  info "running in the same shell."
  info ""
  info "Reload your shell to pick up the hook (open a new terminal, or run):"
  info "  exec \$SHELL -l"
  info ""
  info "If this is an upgrade from an older hook that sourced keys globally,"
  info "already-open shells still have ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL"
  info "in their env. Either reload those shells as above, or run:"
  info "  unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL"
  info ""
  info "Then try:"
  info "  gbrain doctor"
  info "  gbrain search \"your query at least three words\""
  info ""
  info "Other useful commands:"
  info "  gbrain-patchkit doctor       verify env + preload + patch state"
  info "  gbrain-patchkit migrate      switch existing source-patch installs to runtime override"
  info "  gbrain-patchkit env          edit your keys / models"
  info "  gbrain-patchkit edit         edit substitutions.json (custom source patches)"
  info "  gbrain-patchkit check        show source-patch status (legacy)"
  info "  gbrain-patchkit revert       undo source patches (legacy)"
  info "  gbrain-patchkit uninstall    remove shell hook"
  info ""
}

cmd_help() {
  # Print the leading comment block: lines starting at the first non-shebang
  # comment, stopping at the first blank or non-comment line.
  awk 'NR==1 && /^#!/ {next}
       /^#/ {sub(/^# ?/,""); print; next}
       {exit}' "$0"
}

main() {
  local cmd="${FLAGS[0]:-help}"
  case "$cmd" in
    onboard)   cmd_onboard ;;
    install)   cmd_install ;;
    configure) cmd_configure_codex_deepseek ;;
    migrate)   cmd_migrate ;;
    post-upgrade) cmd_post_upgrade ;;
    upgrade)   cmd_upgrade ;;
    repair-upgrade) cmd_repair_upgrade ;;
    overlay-snapshot) cmd_overlay_snapshot ;;
    overlay-apply)    cmd_overlay_apply ;;
    overlay-check)    cmd_overlay_check ;;
    overlay-revert)   cmd_overlay_revert ;;
    apply)     cmd_apply ;;
    check)     cmd_check ;;
    revert)    cmd_revert ;;
    doctor)    cmd_doctor ;;
    edit)      cmd_edit ;;
    env)       cmd_env_cmd ;;
    locate)    cmd_locate ;;
    update)    cmd_update ;;
    uninstall) cmd_uninstall ;;
    help|-h|--help) cmd_help ;;
    *) err "unknown command: $cmd"; cmd_help; exit 2 ;;
  esac
}

main
